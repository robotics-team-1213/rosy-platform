[Unit]
Description=ROSY one-time Pinky Pro personalization
OnFailure=rosy-boot-status.service
Requires=local-fs.target NetworkManager.service
After=local-fs.target NetworkManager.service
Before=network-online.target rosy-sd-provision.service rosy-runtime.target

[Service]
Type=oneshot
ExecStart=/opt/rosy/first-boot/rosy-first-boot.sh
RemainAfterExit=yes
TimeoutStartSec=90
UMask=0077

[Install]
WantedBy=multi-user.target
