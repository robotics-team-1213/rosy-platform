# D-977 4 arm session environment: copy to ~/.config/rosy/omx-session-<arm>.env (mode 0600).
OMX=<installed-tools>/deploy/robot/omx
OMX_PYTHON=<home>/rosy-omx/current-env/bin/python
# The record_session.py arguments of this arm; --io is the chunk-io folder the owner's cell_config also names.
OMX_SESSION_ARGS=--config <private-record-config.json> --caps <private-caps.json> --chunks <library.json> --io <absolute-chunk-io> --params <cell-params.json> --operating-profile <private-robot-profile.json>
