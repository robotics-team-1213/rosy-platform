# D-785 hardware owner environment: copy to ~/.config/rosy/omx-owner-<instance>.env (mode 0600).
ROSY_ROS_SETUP=<ros-setup.bash-sourcing-the-reviewed-overlay>
ROSY_OMX_REPO=<reviewed-rosy-platform-checkout>
ROS_DOMAIN_ID=<explicit-domain-of-the-controller-graph>
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ROSY_OMX_ROS_NAMESPACE=<instance-namespace-or-/>
# Fleet dispatch-control readback (rosy_agent.fleet_fence). On the site Fleet is TLS-only behind the
# proxy (D-785 §4), so use the HTTPS form: literal proxy IP, pinned site CA and the site TLS name.
ROSY_FLEET_FENCE_URL=https://<site-bind-ip>:<site-https-port>/api/fleet/dispatch-control
ROSY_FLEET_FENCE_CA=<absolute-path-to-site-ca.crt>
ROSY_FLEET_FENCE_TLS_NAME=<site-tls-host>
ROSY_FLEET_FENCE_TOKEN=<private-fleet-viewer-credential>
