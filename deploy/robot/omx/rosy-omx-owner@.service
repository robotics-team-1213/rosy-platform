[Unit]
Description=ROSY OMX %i hardware owner (stop and readback; ARM_TRANSFER only with arm_goals, D-785, D-977 4)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# User unit beside the native controller graph. It never opens serial, enables torque or
# starts controllers; the controller graph is a separate, already-reviewed unit. With an arm_goals section in its config
# it sends the folded carry to rosy-omx-arm-session@.service (its own unit, outside this cgroup) and never signals it.
Type=exec
EnvironmentFile=%h/.config/rosy/omx-owner-%i.env
ExecStart=/bin/bash -c 'source "$ROSY_ROS_SETUP"; exec /usr/bin/python3 "$ROSY_OMX_REPO/deploy/robot/omx/run_hardware_owner.py" --config "%h/.config/rosy/omx-owner-%i.json"'
# A restart comes back with the local stop latch closed (LocalStopController starts closed).
# A stale control.sock after a crash refuses start until an operator reviews and removes it.
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=5
NoNewPrivileges=true
UMask=0077
LimitCORE=0
MemoryMax=1G

[Install]
WantedBy=default.target
