+hardware_interface::CallbackReturn DynamixelHardware::on_error(
+  [[maybe_unused]] const rclcpp_lifecycle::State & previous_state)
+{
+  if (stop() != hardware_interface::CallbackReturn::SUCCESS) {
+    RCLCPP_ERROR_STREAM(logger_, "Dynamixel fault cleanup failed; stop remains unverified");
+  }
+  // Cleanup success does not recover the fault or admit another command.
+  return hardware_interface::CallbackReturn::ERROR;
+}
