+static bool HasDxlStatusInterfaces(const hardware_interface::HardwareInfo & info)
+{
+  size_t motors = 0;
+  for (const auto & gpio : info.gpios) {
+    auto type = gpio.parameters.find("type");
+    if (type == gpio.parameters.end() || type->second != "dxl") {continue;}
+    ++motors;
+    size_t torque = 0, hardware_error = 0;
+    for (const auto & state : gpio.state_interfaces) {
+      torque += state.name == "Torque Enable";
+      hardware_error += state.name == "Hardware Error Status";
+    }
+    if (torque != 1 || hardware_error != 1) {return false;}
+  }
+  return motors != 0;
+}
