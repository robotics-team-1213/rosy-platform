[Unit]
Description=ROSY OMX cameras and observers: switch to the newest green main while the cell is idle (D-871)
After=network-online.target

[Service]
Type=oneshot
# D-805: skipped while updates are frozen
ExecCondition=/bin/sh -c 'exec /usr/local/bin/rosy-update-gate'
# The updater runs from the live release, so it updates itself with the services (paths in the config).
ExecStart=/usr/bin/python3 %h/.local/share/rosy/omx-devices/current/deploy/robot/omx/omx_autoupdate.py --config %h/.config/rosy/omx-devices-autoupdate.json run
TimeoutStartSec=1800
Nice=10
