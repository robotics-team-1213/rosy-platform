{
  "schema": "rosy.omx-collection-profile.v1",
  "enabled": false,
  "workcell_id": "<accepted-workcell>",
  "instance_id": "<accepted-instance>",
  "rig_revision": "<measured-rig-revision>",
  "calibration_revision": "<verified-native-normalization-revision>",
  "task": "<one-accepted-bounded-task>",
  "fps": 10,
  "max_image_age_s": 0.25,
  "max_state_age_s": 0.2,
  "max_reference_age_s": 0.2,
  "max_sample_gap_s": 0.3,
  "max_frame_jitter_s": 0.03,
  "max_skew_s": 0.1,
  "max_session_s": 30,
  "free_disk_bytes": 1073741824,
  "joint_names": ["joint1", "joint2", "joint3", "joint4", "joint5", "gripper_joint_1"],
  "normalization": [],
  "camera_shapes": {"top": [480, 640, 3], "front": [480, 640, 3]},
  "camera_mounts": {
    "top": {"parent_frame": "<measured-arm-base-frame>", "translation_m": [0, 0, 0], "rotation_xyzw": [0, 0, 0, 1], "method": "<how-measured>"},
    "front": {"parent_frame": "<measured-arm-base-frame>", "translation_m": [0, 0, 0], "rotation_xyzw": [0, 0, 0, 1], "method": "<how-measured>"}
  },
  "ros": {
    "namespace": "/<accepted-namespace>",
    "joint_state_topic": "/<accepted-joint-state-topic>",
    "reference_topic": "/<accepted-controller-state-topic>",
    "hardware_topic": "/<accepted-dynamixel-state-topic>",
    "trajectory_action": "/<accepted-action-name>",
    "environment_state": "/<home>/.local/state/rosy/omx-camera-environment/readiness.json",
    "controller_pid": 0,
    "controller_start_ticks": "",
    "controller_binary_sha256": "",
    "watchdog_pid": 0,
    "watchdog_start_ticks": "",
    "motor_ids": [11, 12, 13, 14, 15, 16],
    "expected_torque": [true, true, true, true, true, true],
    "max_hardware_age_s": 0.25,
    "image_topics": {"top": "/top_camera/image_raw", "front": "/front_camera/image_raw"},
    "camera_info_topics": {"top": "/top_camera/camera_info", "front": "/front_camera/camera_info"},
    "publishers": {
      "top": {"node_name": "<existing-top-producer>", "node_namespace": "/"},
      "front": {"node_name": "<existing-front-producer>", "node_namespace": "/"},
      "joints": {"node_name": "joint_state_broadcaster", "node_namespace": "/<accepted-namespace>"},
      "reference": {"node_name": "arm_controller", "node_namespace": "/<accepted-namespace>"},
      "hardware": {"node_name": "controller_manager", "node_namespace": "/<accepted-namespace>"}
    },
    "action_server": {"node_name": "arm_controller", "node_namespace": "/<accepted-namespace>"},
    "owner_config": {
      "enabled": true,
      "workcell_id": "<accepted-workcell>",
      "instance_id": "<accepted-instance>",
      "joint_names": ["joint1", "joint2", "joint3", "joint4", "joint5", "gripper_joint_1"],
      "position_limits": {},
      "velocity_limits": {},
      "acceleration_limits": {},
      "max_start_state_tolerances": {},
      "allowed_owners": ["rule_based"],
      "calibration_revision": "<verified-native-normalization-revision>",
      "max_joint_state_age_s": 0.2,
      "max_goal_duration_s": 1,
      "action_timeout_s": 2
    }
  }
}
