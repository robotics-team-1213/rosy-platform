[Unit]
Description=ROSY OMX native tools: switch to the newest green main while the cell is idle
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/rosy-omx/current/deploy/robot/omx/omx_autoupdate.py --config %h/.config/rosy/omx-autoupdate.json run
TimeoutStartSec=900
Nice=10
