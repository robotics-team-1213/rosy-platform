# Non-secret template for split cell-job-api bearer tokens (D-1072 / D-226).
# Provision separate 0600 files containing >=24-char random tokens (never identical).
# chmod 600 ~/.config/rosy/cell-job-human.token ~/.config/rosy/cell-job-machine.token
ROSY_CELL_JOB_HUMAN_TOKEN_FILE=~/.config/rosy/cell-job-human.token
ROSY_CELL_JOB_MACHINE_TOKEN_FILE=~/.config/rosy/cell-job-machine.token
# Optional third token, own file, for the Fleet cell-task worker only (free-position pick with the stop proof). Absent file = off.
ROSY_CELL_JOB_WORKER_TOKEN_FILE=~/.config/rosy/cell-job-worker.token
# Worker-only URL of the cell API: it listens on this host's tailnet address, not on loopback. Replace the documentation address.
ROSY_CELL_JOB_WORKER_URL=http://203.0.113.10:8781
ROSY_FLEET_R_URL=https://10.0.0.2:8443
ROSY_FLEET_TOKEN_FILE=~/.config/rosy/r-site.token
ROSY_FLEET_CA_FILE=~/.config/rosy/r-site-ca.pem
