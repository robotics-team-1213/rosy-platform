# One private file per arm: ~/.config/rosy/omx-observer-arm_a.env, etc.
ROSY_ROS_SETUP=/opt/ros/jazzy/setup.bash
ROSY_OBSERVER_PYTHON=/home/<user>/.local/share/rosy/omx-devices/current-env/bin/python
ROSY_OBSERVER_SOURCE=/home/<user>/.local/share/rosy/omx-devices/current/deploy/robot/omx/hardware_observer.py
PYTHONPATH=/home/<user>/.local/share/rosy/omx-devices/current/contracts/foundation:/home/<user>/.local/share/rosy/omx-devices/current/operations/overhead
ROSY_OBSERVER_DEVICE=/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_EXAMPLE-if00
ROSY_OBSERVER_TOPIC=/omx_commissioning/arm_a/joint_states
ROS_DOMAIN_ID=13
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ROS_STATIC_PEERS=
