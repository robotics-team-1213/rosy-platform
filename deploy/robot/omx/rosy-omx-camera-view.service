[Unit]
Description=ROSY OMX original-frame camera quality viewer (read only)
Wants=rosy-omx-camera@top.service rosy-omx-camera@front.service
After=rosy-omx-camera@top.service rosy-omx-camera@front.service

[Service]
Type=simple
EnvironmentFile=%h/.config/rosy/omx-camera-top.env
EnvironmentFile=%h/.config/rosy/omx-camera-readiness.env
Environment=ROSY_OBSERVATION_DIR=%t/rosy-observations
ExecStart=/bin/bash -c 'export PYTHONPATH="$ROSY_CAMERA_PIPELINE_ROOT/../../../contracts/foundation${PYTHONPATH:+:$PYTHONPATH}"; exec /usr/bin/python3 "$ROSY_CAMERA_PIPELINE_ROOT/commissioning_view.py" --port 8767'
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
