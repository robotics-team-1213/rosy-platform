{
  "kind": "service",
  "idle_gate": "cell",
  "repo_url": "https://github.com/<owner>/rosy-platform.git",
  "github_repo": "<owner>/rosy-platform",
  "branch": "main",
  "required_checks": ["ci-result"],
  "root": "~/.local/share/rosy/omx-devices",
  "base_python": "/usr/bin/python3",
  "lock": "deploy/robot/omx/requirements-observation.lock",
  "system_site_packages": true,
  "paths": ["deploy/robot/omx", "middleware/devices/omx/adapter/omx_adapter/camera_source.py", "contracts/foundation",
            "operations/overhead"],
  "smoke": "import sys; sys.path[:0] = ['deploy/robot/omx', 'contracts/foundation', 'operations/overhead', 'middleware/devices/omx/adapter/omx_adapter']; import hardware_observer, register_probe, passive_motor_health, workcell_observation_bridge, camera_readiness, commissioning_view, camera_source, omx_autoupdate; print('smoke ok')",
  "devices": ["/dev/serial/by-id/<arm_a follower>", "/dev/serial/by-id/<arm_b follower>"],
  "observers": [
    {"unit": "rosy-omx-observer@arm_a.service", "device": "/dev/serial/by-id/<arm_a follower>",
     "health": "/home/<user>/.local/state/rosy/motor-health/arm_a.json"},
    {"unit": "rosy-omx-observer@arm_b.service", "device": "/dev/serial/by-id/<arm_b follower>",
     "health": "/home/<user>/.local/state/rosy/motor-health/arm_b.json"}
  ],
  "units": ["rosy-omx-camera@top.service", "rosy-omx-camera@front.service", "rosy-omx-camera@arm_a_wrist.service",
            "rosy-omx-camera-view.service", "rosy-omx-camera-readiness.service",
            "rosy-omx-observer@arm_a.service", "rosy-omx-observer@arm_b.service",
            "rosy-omx-observation-bridge.service"],
  "unit_files": ["deploy/robot/omx/rosy-omx-camera@.service", "deploy/robot/omx/rosy-omx-camera-view.service",
                 "deploy/robot/omx/rosy-omx-camera-readiness.service", "deploy/robot/omx/rosy-omx-observer@.service",
                 "deploy/robot/omx/rosy-omx-observation-bridge.service",
                 "deploy/robot/omx/rosy-omx-devices-autoupdate.service",
                 "deploy/robot/omx/rosy-omx-devices-autoupdate.timer"],
  "restart_running_only": true,
  "settle": 20,
  "require_verified_commit": false,
  "keep": 3
}
