[Unit]
Description=ROSY Autonomous OMX Cell Task Worker (Fleet-R <-> arm_s, arm_a, arm_b)
After=network-online.target rosy-omx-observation-bridge.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/rosy/omx-observation-bridge.env
Environment=TOOLS_ROOT=%h/.local/share/rosy/omx-devices/current
Environment=PYTHONPATH=%h/.local/share/rosy/omx-devices/current:%h/.local/share/rosy/omx-devices/current/deploy/robot/omx:%h/.local/share/rosy/omx-devices/current/middleware/devices/omx/adapter:%h/.local/share/rosy/omx-devices/current/operations/overhead:%h/.local/share/rosy/omx-devices/current/contracts/foundation
ExecStart=%h/rosy-omx/current-env/bin/python %h/.local/share/rosy/omx-devices/current/deploy/robot/omx/cell_task_worker.py --fleet-r-url https://rosy-fleet-r.local:8443 --token-file %h/.config/rosy-fleet-r-token --ca-file %h/.config/rosy/r-site-ca.pem --execute-mode guarded-pick --interval-s 1.5
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
