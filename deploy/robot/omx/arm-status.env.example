# Private runtime copy: ~/.config/rosy/omx-arm-status.env, mode 0600.
# Verify source/arm against the Fleet manifest; the source credential is arm-only.
ROSY_ARM_STATUS_PYTHON=/home/<user>/.local/share/rosy/omx-devices/current-env/bin/python
ROSY_ARM_STATUS_SOURCE=/home/<user>/.local/share/rosy/omx-devices/current/deploy/robot/omx/arm_status_bridge.py
PYTHONPATH=/home/<user>/.local/share/rosy/omx-devices/current/contracts/foundation:/home/<user>/.local/share/rosy/omx-devices/current/operations/overhead
ROSY_ARM_STATUS_LIVE=/path/to/private/chunk-io/live.json
ROSY_ARM_STATUS_SOURCE_ID=omx_arm_s
ROSY_ARM_STATUS_ARM_ID=omx_s
ROSY_ARM_STATUS_CALIBRATION=/path/to/private/omx_follower_arm.json
# Guard must use ROSY_OMX_MONITOR_OWNER=omx_s and write this canonical absolute file.
ROSY_ARM_STATUS_HEALTH_FILE=/path/to/private/motor-health-current.json
ROSY_ARM_STATUS_FLEET_URL=https://fleet.example.invalid
ROSY_ARM_STATUS_CA_FILE=/path/to/private/site-ca.crt
# Inject the matching arm source credential only in the private copy; empty refuses startup.
ROSY_ARM_S_TOKEN=
