# D-977 5 operator-attested producer environment: copy to ~/.config/rosy/omx-attested-producer-<arm>.env (mode 0600).
OMX=<installed-tools>/deploy/robot/omx
OMX_PRODUCER_PYTHON=<python-with-the-tools/sim-deps>
ROSY_FLEET_ORIGIN=https://<cell-fleet-origin>
ROSY_TRANSFER_OBSERVER_TOKEN=<observer-token-of-operator-attested-producer>
OMX_PRODUCER_ASSETS=<open_manipulator_description>
OMX_PRODUCER_INSTALLATION=<written installation.json>
OMX_PRODUCER_LIVE=<absolute-chunk-io>/live.json
OMX_PRODUCER_CALIBRATION=<omx_follower_arm.json>
# its coarse.grip_open is the open jaw value; without it the gripper is reported UNKNOWN, never OPEN
OMX_PRODUCER_PIPELINE=<cell-pipeline.json>
