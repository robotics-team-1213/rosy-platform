[Unit]
Description=ROSY OMX automatic camera tuning and photometric readiness
Requires=rosy-omx-camera-view.service
# The role aliases (/dev/v4l/by-id/rosy-*) come from the bind; at boot it ran 20 s after this start, so all three
# retries failed on a missing alias and readiness stayed down until a person restarted it (2026-11-08).
Wants=rosy-omx-cameras-bind.service
After=rosy-omx-camera-view.service rosy-omx-cameras-bind.service
# A refused start runs ExecStopPost restore; the documented recovery is one more start (2026-10-23/24).
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=%h/.config/rosy/omx-camera-readiness.env
ExecStart=/usr/bin/python3 ${ROSY_CAMERA_PIPELINE_ROOT}/camera_readiness.py run --profile %h/.config/rosy/omx-camera-readiness.json --state-dir %h/.local/state/rosy/omx-camera-environment
ExecStopPost=/usr/bin/python3 ${ROSY_CAMERA_PIPELINE_ROOT}/camera_readiness.py restore --state-dir %h/.local/state/rosy/omx-camera-environment
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
