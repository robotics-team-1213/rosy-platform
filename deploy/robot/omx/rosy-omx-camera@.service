[Unit]
Description=ROSY OMX %i camera preview (no arm authority)
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=%h/.config/rosy/omx-camera-%i.env
Environment=ROSY_OBSERVATION_DIR=%t/rosy-observations
# The registration key selects private latest-value IPC; no ROS setup or DDS is used.
ExecStart=:/bin/bash -c 'root="${ROSY_CAMERA_SOURCE%%/middleware/*}"; export PYTHONPATH="$root/contracts/foundation:$root/deploy/robot/omx${PYTHONPATH:+:$PYTHONPATH}"; camera_entrypoint="$ROSY_CAMERA_SOURCE"; case "${ROSY_CAMERA_TIMESTAMP_MODE:-preview}" in preview) ;; exposure) export PYTHONPATH="$root/middleware/devices/omx/adapter/omx_adapter:$PYTHONPATH"; camera_entrypoint="$root/deploy/robot/omx/camera_exposure.py";; *) exit 2;; esac; exec /usr/bin/python3 "$camera_entrypoint" --device "$ROSY_CAMERA_DEVICE" --topic "$ROSY_CAMERA_TOPIC" --frame-id "$ROSY_CAMERA_FRAME" --max-fps "${ROSY_CAMERA_MAX_FPS:-15}"'
Restart=on-failure
RestartSec=2
WatchdogSec=8
WatchdogSignal=SIGTERM
NotifyAccess=main
TimeoutStopSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
