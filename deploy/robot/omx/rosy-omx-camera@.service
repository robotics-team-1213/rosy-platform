[Unit]
Description=ROSY OMX %i camera preview (no arm authority)
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=%h/.config/rosy/omx-camera-%i.env
ExecStart=/bin/bash -c 'source "$ROSY_ROS_SETUP"; exec /usr/bin/python3 "$ROSY_CAMERA_SOURCE" --device "$ROSY_CAMERA_DEVICE" --topic "$ROSY_CAMERA_TOPIC" --frame-id "$ROSY_CAMERA_FRAME"'
Restart=on-failure
RestartSec=2
WatchdogSec=8
WatchdogSignal=SIGTERM
NotifyAccess=main
TimeoutStopSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
