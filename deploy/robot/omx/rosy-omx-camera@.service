[Unit]
Description=ROSY OMX %i camera preview (no arm authority)
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=%h/.config/rosy/omx-camera-%i.env
# No-cross-host DDS: set after sourcing so neither the env file nor the ROS setup can widen discovery.
ExecStart=/bin/bash -c 'source "$ROSY_ROS_SETUP"; export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST ROS_STATIC_PEERS=; exec /usr/bin/python3 "$ROSY_CAMERA_SOURCE" --device "$ROSY_CAMERA_DEVICE" --topic "$ROSY_CAMERA_TOPIC" --frame-id "$ROSY_CAMERA_FRAME" --max-fps "${ROSY_CAMERA_MAX_FPS:-10}"'
Restart=on-failure
RestartSec=2
WatchdogSec=8
WatchdogSignal=SIGTERM
NotifyAccess=main
TimeoutStopSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
