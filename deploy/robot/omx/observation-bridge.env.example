# Private runtime copy must be mode 0600. Paths and identities require host verification.
ROSY_OBSERVATION_PYTHON=/home/<user>/.local/share/rosy/omx-devices/current-env/bin/python
ROSY_OBSERVATION_SOURCE=/home/<user>/.local/share/rosy/omx-devices/current/deploy/robot/omx/workcell_observation_bridge.py
PYTHONPATH=/home/<user>/.local/share/rosy/omx-devices/current/contracts/foundation:/home/<user>/.local/share/rosy/omx-devices/current/operations/overhead
ROSY_WORKCELL_OBSERVATIONS=/path/to/private/workcell-observations.yaml
ROSY_OBSERVATION_WORKCELL=example_bench
ROSY_OBSERVATION_FLEET_URL=https://fleet.example.invalid
ROSY_OBSERVATION_VISION_URL=wss://vision.example.invalid/overhead/v1/frames
ROSY_OBSERVATION_CA_FILE=/path/to/site-ca.crt
# One SOURCE_ID=file per arm of this cell (one arm or two); the observers write these files.
ROSY_OBSERVATION_ARM_HEALTH=omx_arm_a=/home/<user>/.local/state/rosy/motor-health/arm_a.json omx_arm_b=/home/<user>/.local/state/rosy/motor-health/arm_b.json
# Local snapshot directory is set consistently by the native systemd units.
# Manifest topic-shaped strings are registration keys; no ROS runtime is loaded.
# Inject five distinct credentials matching the manifest fingerprints into this
# private file. Fleet receives only arm credentials; Vision receives only cameras.
ROSY_ARM_A_TOKEN=
ROSY_ARM_B_TOKEN=
ROSY_CAMERA_OVERHEAD_TOKEN=
ROSY_CAMERA_WRIST_A_TOKEN=
ROSY_CAMERA_WRIST_B_TOKEN=
