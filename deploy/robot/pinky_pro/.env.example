# Immutable release images should replace these development defaults.
ROS_IMAGE=ros:jazzy-ros-base
ROSY_CORE_IMAGE=rosy-core:dev
ROSY_IO_IMAGE=rosy-io:dev

# 로봇 신원은 여기에 값으로 두지 않는다. 값이 있으면 install-pi.sh 의
# set_env_default 가 영영 발화하지 못해 모든 기기가 같은 도메인/네임스페이스로
# 출고된다 — 이 파일이 곧 충돌의 원인이었다.
# 규칙: ROSY_ROBOT_NUMBER=N 으로부터 ROS_DOMAIN_ID = 40 + N, ROSY_NAMESPACE = rosy_%02d
# 를 설치 시점에 생성한다 (ADR D-33).
ROSY_CMD_VEL_TIMEOUT_S=0.5
ROSY_MOTOR_BAUDRATE=1000000
ROSY_MOTOR_IDS=[1,2]
ROSY_MAX_LINEAR_MPS=0.20
ROSY_MAX_ANGULAR_RPS=0.80
ROSY_MAX_WHEEL_RPM=100.0
ROSY_MOTOR_PROFILE_ACCELERATION=200

# First deployment starts the dashboard/core only. Change to motor for
# drivetrain commissioning, then hardware after LiDAR acceptance.
# Selects deploy/robot/pinky_pro/config/{profile,capabilities}.${ROSY_RUNTIME_MODE}.yaml
ROSY_RUNTIME_MODE=core
# Orthogonal hardware graph selector. `slam` is accepted only with hardware.
ROSY_NAVIGATION_BACKEND=localization

# Raspberry Pi device nodes.
ROSY_MOTOR_DEVICE=/dev/ttyAMA4
ROSY_LIDAR_DEVICE=/dev/ttyAMA0
ROSY_CAMERA_DEVICE=/dev/video0
ROSY_I2C_DEVICE=/dev/i2c-1
ROSY_LINE_FOLLOW_CONFIG_PATH=./config/line_follow.yaml

# Values from: id -u rosy; id -g rosy; getent group dialout
ROSY_UID=1000
ROSY_GID=1000
ROSY_DIALOUT_GID=20
ROSY_VIDEO_GID=44
ROSY_I2C_GID=998

# Provision this file outside the repository with non-development tokens.
ROSY_CONFIG_PATH=/etc/rosy/rosy.yaml
ROSY_DATA_PATH=/var/lib/rosy
ROSY_HOST_ROOT=/host

# Hardware Nav2 occupancy map (YAML + image in the same directory).
# Missing files fall back to the packaged demo map; that is not a site map.
ROSY_MAP=/var/lib/rosy/maps/site.yaml
