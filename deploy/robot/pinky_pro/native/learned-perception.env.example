# D-373 on-device switch for the learned-perception payload features.
# Install as /etc/rosy/learned-perception.env (root:root 0644), then
#   sudo systemctl restart rosy-camera
# rosy-camera.service reads it (EnvironmentFile=-, so no file = both off) and
# camera_preview.launch.py turns each value into its launch argument default.
# Only "true" and "false" count; anything else is off, with a warning in the journal.
#
# ROSY_LEARNED_SHADOW: learned_lane_node runs the shadow model from
#   /var/lib/rosy/models/shadow. Shadow only: driving never reads it (D-205).
# ROSY_CAPTURE: camera/front/compressed, capture_trigger_node and the rosbag2
#   snapshot recorder; sessions stay on the robot under /var/lib/rosy/camera/recordings.
# ROSY_LEARNED_MAX_HZ (optional, default 3.0; 0 = every frame): how often the
#   shadow model infers. A Pi 5 at the full 8 fps spent ~175 % CPU (2026-10-01).
ROSY_LEARNED_SHADOW=false
ROSY_CAPTURE=false
