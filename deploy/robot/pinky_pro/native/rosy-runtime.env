# Non-secret template. First boot writes the device-specific copy to
# /etc/rosy/runtime.env with mode 0600 after identity validation.
ROS_DOMAIN_ID=
ROSY_NAMESPACE=
ROSY_ROBOT_NUMBER=
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///etc/rosy/cyclonedds.xml
ROSY_CMD_VEL_TIMEOUT_S=0.5
ROSY_RUNTIME_MODE=core
ROSY_NAVIGATION_BACKEND=localization
ROSY_MAP=/var/lib/rosy/maps/site.yaml
ROSY_MOTION_PROFILE_FILE=/etc/rosy/motion_profiles.yaml
# D-193 7: device mode. CORE refuses the shared rosy-dev-* API credentials and
# plaintext entries, and ignores ROSY_DEV_AUTH.
ROSY_DEPLOYMENT=device
