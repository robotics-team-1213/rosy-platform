[Unit]
Description=ROSY device personalization completion gate
OnFailure=rosy-boot-status.service
Requires=rosy-first-boot.service
After=rosy-first-boot.service
AssertPathExists=/var/lib/rosy/provisioning/complete.json
Before=rosy-core.service rosy-runtime.target
# CORE maintenance stops must invalidate this cached admission too.
PartOf=rosy-core.service

[Service]
Type=oneshot
RuntimeDirectory=rosy-os-state
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 -I -B /opt/rosy/native-runtime/os_storage_dispatch.py --projected
ExecStart=/usr/bin/test -s /var/lib/rosy/provisioning/complete.json
RemainAfterExit=yes
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/run/rosy-os-state -/var/lib/rosy-device/state/config.lock
