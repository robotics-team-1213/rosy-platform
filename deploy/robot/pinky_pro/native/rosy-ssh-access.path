[Unit]
Description=ROSY SSH access on an administrator's request (D-418)
# CORE writes /run/rosy/ssh-access.request (its own RuntimeDirectory) through
# /api/v1/host/ssh/...; rosy-ssh-access.py reads it strictly and consumes it.

[Path]
PathChanged=/run/rosy/ssh-access.request
Unit=rosy-ssh-access.service

[Install]
WantedBy=multi-user.target
