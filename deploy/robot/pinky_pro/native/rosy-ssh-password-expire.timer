[Unit]
Description=ROSY temporary SSH password expiry check (D-418)
# Not enabled: rosy-ssh-access starts it with a password and stops it after.
# A password is at most 30 s past its expires_at before it is turned off.

[Timer]
OnActiveSec=30s
OnUnitActiveSec=30s
AccuracySec=5s
Unit=rosy-ssh-password-expire.service
