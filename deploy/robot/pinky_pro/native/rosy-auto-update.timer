[Unit]
Description=Check for a ROSY payload update every 10 minutes (D-410)

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
# Two robots booted together must not hit GitHub, or apply, in lockstep.
RandomizedDelaySec=2min
# No Persistent=: it only applies to OnCalendar= timers; OnBootSec= already
# covers a robot that was off when a run was due.

[Install]
WantedBy=timers.target
