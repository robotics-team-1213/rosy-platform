# ROSY WS2812 lamp (D-247): /dev/ws281x_pwm from the rp1_ws281x_pwm kernel
# module the image builds for its kernel. Only root units open it
# (rosy-hw-test.service's lamp test through lamp_selftest, DeviceAllow), so the
# node is root:root 0600: no service group can drive the lamp around that test.
# Installed by deploy/image.
ACTION=="add|change", SUBSYSTEM=="misc", KERNEL=="ws281x_pwm", OWNER="root", GROUP="root", MODE="0600"
