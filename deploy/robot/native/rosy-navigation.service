[Unit]
Description=ROSY native Pinky Pro approved navigation runtime
Requires=rosy-core.service
After=rosy-core.service
Conflicts=rosy-io.service
ConditionPathExists=/etc/rosy/approvals/hardware.approved
ConditionPathExists=/etc/rosy/approvals/navigation.approved

[Service]
Type=simple
User=rosy-io
Group=rosy-io
SupplementaryGroups=dialout i2c video gpio spi
EnvironmentFile=/etc/rosy/runtime.env
# D-174 F6: no home under ProtectHome=true; keep ROS logs in a service-owned directory.
LogsDirectory=rosy-navigation
Environment=ROS_HOME=/var/log/rosy-navigation ROS_LOG_DIR=/var/log/rosy-navigation
# D-189 D3: a writable HOME under the unit's own state directory. The passwd
# home is under /home, which ProtectHome=true makes unreadable (EACCES).
StateDirectory=rosy/navigation
StateDirectoryMode=0750
Environment=HOME=/var/lib/rosy/navigation
# D-189 review: HOME is writable, so nothing may run from it. No login shell
# (~/.profile, ~/.bash_profile) and no user site (~/.local, usercustomize);
# the environment reaches ExecStartPost's python as well.
Environment=PYTHONNOUSERSITE=1
WorkingDirectory=/opt/rosy/current
ExecStart=/usr/bin/bash --noprofile --norc -c 'source /opt/ros/jazzy/setup.bash && source /opt/rosy/current/install/setup.bash && exec ros2 launch navigation hardware.launch.py namespace:=${ROSY_NAMESPACE} navigation_backend:=${ROSY_NAVIGATION_BACKEND} cmd_vel_timeout_s:=${ROSY_CMD_VEL_TIMEOUT_S} motor_device:=/dev/rosy-motor map:=${ROSY_MAP}'
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGINT
UMask=0027

NoNewPrivileges=true
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/rosy-motor rw
DeviceAllow=/dev/ttyAMA0 rw
DeviceAllow=/dev/i2c-1 rw
DeviceAllow=/dev/video0 rw
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# commissioning/ is not created by the image; a missing ReadWritePaths entry
# fails the unit with 226/NAMESPACE, so it is optional ("-").
ReadWritePaths=/var/lib/rosy/maps -/var/lib/rosy/commissioning /run/rosy
