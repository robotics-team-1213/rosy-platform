[Unit]
Description=ROSY native CORE runtime
Requires=rosy-release-recover.service rosy-sd-provision.service
After=network-online.target rosy-release-recover.service rosy-sd-provision.service
Wants=network-online.target
PartOf=rosy-runtime.target

[Service]
Type=simple
User=rosy-core
Group=rosy-core
EnvironmentFile=/etc/rosy/runtime.env
WorkingDirectory=/opt/rosy/current
# Exec the core entry script itself, not `ros2 run`: the wrapper turns a signal death of
# the node into exit status 256-N (241/254), which systemd counts as failure. Run
# directly, a SIGINT/SIGTERM that lands before core installs its handlers is a clean
# signal exit for systemd. Path follows the --merge-install payload layout.
ExecStart=/usr/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /opt/rosy/current/install/setup.bash && exec /opt/rosy/current/install/lib/core/core --ros-args -r __ns:=/${ROSY_NAMESPACE}'
ExecStartPost=/usr/bin/python3 /opt/rosy/current/deploy/robot/native/wait-core-ready.py
Restart=on-failure
RestartSec=2
TimeoutStartSec=60
TimeoutStopSec=15
KillSignal=SIGINT
StateDirectory=rosy
RuntimeDirectory=rosy
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
DevicePolicy=closed
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/rosy /run/rosy

[Install]
WantedBy=rosy-runtime.target
