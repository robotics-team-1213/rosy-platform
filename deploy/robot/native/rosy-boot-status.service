[Unit]
Description=ROSY boot status indicator (LED, console, mDNS; D-174 T0)
After=rosy-runtime.target avahi-daemon.service
Wants=avahi-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/rosy/native-runtime/rosy-boot-status.py
TimeoutStartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
