[Unit]
Description=ROSY native release recovery gate
OnFailure=rosy-boot-status.service
DefaultDependencies=no
Requires=local-fs.target
After=local-fs.target
Before=rosy-core.service rosy-runtime.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/rosy/native-runtime/recover-release.sh
TimeoutStartSec=60
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# D-183 D1: recover always takes native-release.lock and may rewrite the
# activation journal under /var/lib/rosy/releases, and it swaps the
# /opt/rosy/{current,previous} links through a temporary link in /opt/rosy.
# ProtectSystem=strict makes all of that read-only unless it is listed here.
StateDirectory=rosy/releases
ReadWritePaths=/opt/rosy

[Install]
WantedBy=multi-user.target
