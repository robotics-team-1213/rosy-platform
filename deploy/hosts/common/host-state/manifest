# D-530 desired state shared by the site, model and AI PCs. One line: <policy> <kind> <args>.
# policy: safe (the timer fixes it), report (install applies, timer reports), approval (only with --approve;
# approval=<group> is also approved by --approve <group>).
# file sources: role/<name> is the role's host-state folder, common/<name> is this folder.
safe file /etc/systemd/system/rosy-host-state.service common/rosy-host-state.service
safe file /etc/systemd/system/rosy-host-state.timer common/rosy-host-state.timer
safe enabled rosy-host-state.timer
safe file /etc/systemd/logind.conf.d/rosy-no-lid-suspend.conf common/rosy-no-lid-suspend.conf
safe enabled tailscaled.service
safe linger
report masked sleep.target
report masked suspend.target
report masked hibernate.target
report masked hybrid-sleep.target
approval file /etc/ssh/sshd_config.d/10-rosy.conf common/sshd-10-rosy.conf
# D-524 Service Control helper: the one execution path for restart-unit and reboot (Fleet operator
# and this guard). Root rights for the guard: approval only.
approval file /usr/local/sbin/rosy-host-control deploy/site/rosy-host-control 0755
approval file /etc/sudoers.d/rosy-host-control common/sudoers-rosy-host-control.in 0440
approval file /etc/rosy/host-control/role role/host-control-role
# mDNS only on physical interfaces (no docker veth/bridge link-local advertisements).
safe file /usr/local/sbin/rosy-avahi-interfaces deploy/hosts/common/rosy-avahi-interfaces 0755
safe file /etc/systemd/system/rosy-avahi-interfaces.service deploy/hosts/common/rosy-avahi-interfaces.service
safe enabled rosy-avahi-interfaces.service
