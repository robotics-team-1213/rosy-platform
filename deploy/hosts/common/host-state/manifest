# D-530 desired state shared by the site, model and AI PCs. One line: <policy> <kind> <args>.
# policy: safe (the timer fixes it), report (install applies, timer reports), approval (only with --approve;
# approval=<group> is also approved by --approve <group>).
# file sources: role/<name> is the role's host-state folder, common/<name> is this folder.
safe file /usr/local/sbin/rosy_host_recovery.py deploy/hosts/common/rosy_host_recovery.py 0644
safe file /etc/systemd/system/rosy-host-state.service common/rosy-host-state.service
safe file /etc/systemd/system/rosy-host-state.timer common/rosy-host-state.timer
safe enabled rosy-host-state.timer
safe file /etc/systemd/logind.conf.d/rosy-no-lid-suspend.conf common/rosy-no-lid-suspend.conf
safe enabled tailscaled.service
safe linger
report masked sleep.target
report masked suspend.target
report masked hibernate.target
report masked hybrid-sleep.target
# Declined by the user on 2026-10-09 (D-530 6): SSH password login stays ON. The sshd drop-in line is
# removed on purpose; sshd-10-rosy.conf stays in this folder only as the key-only option, never installed.
# D-524 Service Control helper: the one execution path for restart-unit and reboot (Fleet operator
# and this guard). Root rights for the guard: approval only.
approval file /usr/local/sbin/rosy-host-control deploy/site/rosy-host-control 0755
approval file /etc/sudoers.d/rosy-host-control common/sudoers-rosy-host-control.in 0440
approval file /etc/rosy/host-control/role role/host-control-role
# mDNS only on physical interfaces (no docker veth/bridge link-local advertisements).
safe file /usr/local/sbin/rosy-avahi-interfaces deploy/hosts/common/rosy-avahi-interfaces 0755
safe file /etc/systemd/system/rosy-avahi-interfaces.service deploy/hosts/common/rosy-avahi-interfaces.service
safe enabled rosy-avahi-interfaces.service
# D-802: uv is the one Python installer on every lab PC (remote_pytest venvs, remote_sim pins); pinned wheel,
# hash-checked, installed with the distro pip, linked as /usr/local/bin/uv and uvx. Bump both version and hash.
approval=uv apt python3-pip
approval=uv wheel-tool uv 0.12.22 680769ef701922dd93426b73476073411941f51ac46991a6e5c5a6efbf68a713 # SHA256 wheel integrity
# New-PC recovery baseline: one explicit installation approval; later checks report drift.
# Never overwrite /etc/default/rosy-ssh-watchdog: local limits and robot flags stay host-owned.
approval=recovery file /usr/local/sbin/rosy-ssh-watchdog deploy/hosts/common/rosy-ssh-watchdog 0755
approval=recovery file /etc/systemd/system/rosy-ssh-watchdog.service deploy/hosts/common/rosy-ssh-watchdog.service
approval=recovery file /etc/systemd/system/rosy-ssh-watchdog.timer deploy/hosts/common/rosy-ssh-watchdog.timer
approval=recovery enabled rosy-ssh-watchdog.timer
approval=recovery file /usr/local/sbin/rosy-host-guard-remote deploy/hosts/common/rosy-host-guard-remote 0755
approval=recovery file /etc/systemd/system/rosy-watchdog-load.service common/rosy-watchdog-load.service
approval=recovery enabled rosy-watchdog-load.service
approval=recovery file /etc/systemd/system.conf.d/rosy-watchdog.conf common/rosy-watchdog.conf
approval=recovery file /etc/sysctl.d/90-rosy-hang.conf common/90-rosy-hang.conf
# D-805 update gate: skip updaters while updates are frozen (ops-update-freeze tag or a local freeze file).
safe file /usr/local/bin/rosy-update-gate common/rosy-update-gate 0755
