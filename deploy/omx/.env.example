# Workstation ROS graph settings. OMX stays separate from Pinky by default.
OMX_ROS_DOMAIN_ID=30
OMX_ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# Simulation uses a separate domain and LOCALHOST discovery regardless of this
# setting, so it cannot join the workstation or Pinky graph.
OMX_SIM_DOMAIN_ID=31
