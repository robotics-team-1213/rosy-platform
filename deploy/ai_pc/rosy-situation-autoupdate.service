[Unit]
Description=ROSY situation service: switch to the newest green main and restart it (D-805)
After=network-online.target

[Service]
Type=oneshot
# D-805: skipped while updates are frozen
ExecCondition=/bin/sh -c 'exec /usr/local/bin/rosy-update-gate'
# The updater runs from the live release, so it updates itself with the service (paths in the config).
ExecStart=/usr/bin/python3 %h/rosy-situation/current/deploy/robot/omx/omx_autoupdate.py --config %h/.config/rosy/situation-autoupdate.json run
TimeoutStartSec=1800
Nice=10
