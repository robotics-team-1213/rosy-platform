[Unit]
Description=ROSY approved Laya inference smoke (loopback only)
After=network.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/rosy-decision-eval
Environment=LAYA_HOST=127.0.0.1
Environment=LAYA_PORT=8000
Environment=LAYA_DEVICE=cuda
Environment=LAYA_MODELS=multilingual
ExecStartPre=/usr/bin/nvidia-smi -L
ExecStart=%h/rosy-decision-eval/.venv/bin/python -m laya.serve
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
