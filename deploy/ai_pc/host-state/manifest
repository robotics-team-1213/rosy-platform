# D-530 AI PC desired state (role: ai). Format: deploy/hosts/common/host-state/manifest.
# Nightly reboot was copied byte for byte from the AI PC on 2026-10-09. The AI PC is shared:
# install only after its owner agrees (D-530 5).
safe file /etc/systemd/system/rosy-nightly-reboot.timer role/rosy-nightly-reboot.timer
safe file /etc/systemd/system/rosy-nightly-reboot.service role/rosy-nightly-reboot.service
safe enabled rosy-nightly-reboot.timer
report wifi-allow
# PC recovery is shared: install with --approve recovery (common/manifest).
# D-571 headless Gazebo bench: gz_sim's dependency closure (package.xml files up to gz_sim). Only with
# --approve sim; the timer reports. Not listed: sllidar_ros2 (no Jazzy deb, device only), tf_transformations
# and joint_state_publisher_gui (not on the bench path). CORE's pip pins come from tools/remote/remote_sim.py.
approval=sim apt ros-jazzy-ros-gz ros-jazzy-gz-ros2-control ros-jazzy-navigation2 ros-jazzy-nav2-bringup ros-jazzy-slam-toolbox ros-jazzy-rosbag2-storage-mcap ros-jazzy-realtime-tools ros-jazzy-xacro ros-jazzy-robot-state-publisher ros-jazzy-joint-state-publisher python3-opencv python3-numpy python3-colcon-common-extensions
# D-805 update gate: skip updaters while updates are frozen (ops-update-freeze tag or a local freeze file).
safe file /etc/systemd/system/rosy-nightly-reboot.service.d/10-update-gate.conf common/10-update-gate.conf
# D-883: owner of the lab user units and rosy-test-storage.service; clean-storage refuses without it.
approval=recovery file /etc/rosy/host-control/units-user common/host-control-units-user.in
