# Copy to an operator-managed env file outside the public repository.
ROSY_SITE_CONFIG_DIR=/etc/rosy/site
ROSY_SITE_SECRETS_DIR=/etc/rosy/site/secrets
# 127.0.0.1 = this host only (SSH tunnel or local reverse proxy).
# LAN access: 0.0.0.0 (or :: for an IPv6-only bind) plus ROSY_SITE_LAN_IFACE. Never a literal LAN IP:
# it dies with the address when the site LAN changes. See README "LAN access".
ROSY_SITE_BIND_ADDRESS=127.0.0.1
# LAN interface name(s) allowed to reach the published port, comma-separated (e.g. wlan0 or eth0).
ROSY_SITE_LAN_IFACE=
ROSY_SITE_HTTPS_PORT=8443
# Set to the exact .local name present in the site TLS certificate SAN.
ROSY_SITE_TLS_HOST=
ROSY_SITE_IMAGE_TAG=local
