# Copy to an operator-managed env file outside the public repository.
# Plain KEY=VALUE lines only (no "export"): Compose, systemd and site-firewall.py read this file.
ROSY_SITE_CONFIG_DIR=/etc/rosy/site
# Outside the config dir on purpose: Vision mounts only site-cameras.yaml from the config dir (D-524 review).
ROSY_SITE_SECRETS_DIR=/etc/rosy/site-secrets
# 127.0.0.1 = this host only (SSH tunnel or local reverse proxy).
# LAN access: 0.0.0.0 plus ROSY_SITE_LAN_IFACE. Never a literal LAN IP (it dies with the address
# when the site LAN changes; refused unless ROSY_SITE_ALLOW_LITERAL_BIND=1). "::" is refused.
# See README "LAN access".
ROSY_SITE_BIND_ADDRESS=127.0.0.1
# LAN interface name(s) allowed to reach the published port, comma-separated (e.g. wlan0, eth0,
# or br0 for a bridged LAN; add tailscale0 so tailnet team members reach the console, D-477).
# Loopback is always allowed.
ROSY_SITE_LAN_IFACE=
# Required HTTPS port. The proxy publishes this port and listens on it.
# Compose, Caddy, the firewall and mDNS read this value. 8443 below is a sample, not a code default.
ROSY_SITE_HTTPS_PORT=8443
# Required listen ports on the site network. They stay unpublished. Phones and mDNS use
# ROSY_SITE_HTTPS_PORT. 8090 and 8095 below are samples, not code defaults.
ROSY_FLEET_PORT=8090
ROSY_VISION_PORT=8095
# D-796 advisory context/log mirror (site host only). The postgres service reads
# this; Fleet talks to it over the internal network only. The SQLite ledger is
# unchanged. The password lives in secrets/postgres_password. 50 below is a sample.
ROSY_SITE_PG_MAX_CONNECTIONS=50
# Set to the exact .local name present in the site TLS certificate SAN.
ROSY_SITE_TLS_HOST=
ROSY_SITE_IMAGE_TAG=local
# Optional public TLS bindings for already enrolled robot IDs (not a second roster).
# Container path under /run/rosy-config; leave empty for legacy enrollment transport.
ROSY_SITE_ENROLLED_TLS_BINDINGS_FILE=

# D-341 camera pairing (off by default; README "Camera pairing (D-341)"). To turn it on set
# ROSY_SITE_PAIRING=1 and the overlay below, both here, then create secrets/pairing_sync_token
# (site-firewall.py apply copies the switch to the advertise unit).
# Leave both empty to keep today's static-token behaviour.
ROSY_SITE_PAIRING=
# -f <candidate>/deploy/site/compose.pairing.yaml  (empty = no overlay; site.env is read by systemd
# and Compose, so write it unquoted on one line)
ROSY_SITE_PAIRING_COMPOSE=

# Optional workcell observations (README "Workcell observations"). Append the signed
# compose.workcell.yaml after pairing/omx and before Account in ROSY_SITE_PAIRING_COMPOSE.
# Provision all inputs outside ROSY_SITE_CONFIG_DIR; separate arm and camera directories.
ROSY_SITE_WORKCELL_MANIFEST=
ROSY_SITE_WORKCELL_ARM_SECRETS_DIR=
ROSY_SITE_WORKCELL_CAMERA_SECRETS_DIR=
# Optional complete Fleet arm credential JSON mapping; empty keeps the A/B default.
# Values name files inside /run/rosy-workcell-arm-secrets, never token contents.
ROSY_SITE_WORKCELL_ARM_CREDENTIAL_PATHS=

# Optional independent Monitoring (README "ROSY Monitoring (D-936)"). Append the signed
# compose.monitoring.yaml after pairing/omx/workcell and before Account. Both stay outside
# ROSY_SITE_CONFIG_DIR: the config file (uid 10001 readable) and a root-only secrets directory.
ROSY_SITE_MONITORING_CONFIG=
ROSY_SITE_MONITORING_SECRETS_DIR=

# D-473 console development connection mode (README "Development connection mode (D-473)").
# Same-LAN browsers get a 1 h operator session without a token. Both must be "development";
# leave either empty for the normal site user token. Only on a trusted development LAN.
ROSY_DEPLOYMENT=
ROSY_FLEET_CONNECTION_MODE=
