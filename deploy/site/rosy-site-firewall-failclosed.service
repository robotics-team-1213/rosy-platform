[Unit]
Description=Close the ROSY site HTTPS port after a failed firewall apply or check
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
# Must equal --project-name in rosy-site-stack.service. The proxy is selected by its Compose
# labels, with no env or Compose file parse, so a broken config cannot keep the port open.
Environment=ROSY_SITE_PROJECT=rosy-site
ExecStart=/bin/sh -c 'docker ps -q --filter label=com.docker.compose.project=$${ROSY_SITE_PROJECT} --filter label=com.docker.compose.service=proxy | xargs -r docker stop'
