FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/rosy-venv/bin:$PATH \
    PYTHONPATH=/opt/rosy/apps/gateway/src:/opt/rosy/src/site/fleet:/opt/rosy/src/contracts/foundation

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv libnss-mdns \
    && sed -i 's/^hosts:.*/hosts: files mdns4_minimal [NOTFOUND=return] dns mdns4/' /etc/nsswitch.conf \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 rosy \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin rosy \
    && install -d -o 10001 -g 10001 /var/lib/rosy /opt/rosy/src/site/fleet \
       /opt/rosy/src/contracts/foundation /opt/rosy/apps/gateway/src /opt/rosy/web-common

COPY deploy/site/requirements-fleet.txt /opt/rosy/requirements.txt
COPY deploy/site/secret_exec.py /opt/rosy/secret_exec.py
COPY deploy/site/site_db.py /opt/rosy/site_db.py
COPY operations/fleet/ /opt/rosy/src/site/fleet/
COPY contracts/foundation/core_common/ /opt/rosy/src/contracts/foundation/core_common/
COPY operations/apps/fleet/src/ /opt/rosy/apps/gateway/src/
COPY shared/web/ /opt/rosy/web-common/
# D-375 console map-fit overlay: site lane geometry, display only (--site-lane-graph/--site-lane-paint).
COPY middleware/perception/map/map_v2_fleet/lane_graph.yaml middleware/perception/map/map_v2_fleet/meshes/road_lines.stl /opt/rosy/maps/map_v2_fleet/

RUN python3 -m venv /opt/rosy-venv \
    && /opt/rosy-venv/bin/pip install --no-cache-dir -r /opt/rosy/requirements.txt \
    && /opt/rosy-venv/bin/python -c "from zeroconf import ServiceBrowser, Zeroconf" \
    && rm /opt/rosy/requirements.txt

WORKDIR /opt/rosy
EXPOSE 8090
USER 0:0
ENTRYPOINT ["python3", "/opt/rosy/secret_exec.py"]
CMD ["--", "python3", "-m", "fleet.cli", "console", "--robots", "/run/rosy-config/robots.yaml", "--host", "0.0.0.0", "--port", "8090", "--web-common", "/opt/rosy/web-common", "--token-env", "ROSY_SITE_REGISTRY_TOKEN", "--sightings-config", "/run/rosy-config/site-cameras.yaml", "--sightings-db", "/var/lib/rosy/fleet.sqlite3", "--tasks-db", "/var/lib/rosy/fleet.sqlite3"]
