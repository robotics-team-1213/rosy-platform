# D-789 site media gateway: TLS in front of the loopback media authority (/v1/*) and MediaMTX
# WHIP/WHEP. Shares the media container's network namespace. /auth, /health and the MediaMTX
# management API stay unreachable from the LAN. Tokens are bearer headers, never cookies, so
# cross-origin reads from robot CORE pages are allowed without credentials.
{
	admin off
	auto_https off
}

:{$ROSY_MEDIA_HTTPS_PORT} {
	tls /run/secrets/media_cert /run/secrets/media_key

	@authority path /v1/*
	handle @authority {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
		@preflight method OPTIONS
		respond @preflight 204
		reverse_proxy 127.0.0.1:9121
	}

	@media path_regexp media ^/robots/[A-Za-z0-9._-]{1,96}/front/(whip|whep)(/[A-Za-z0-9-]+)?$
	handle @media {
		reverse_proxy 127.0.0.1:8889
	}

	handle {
		respond 404
	}
}
