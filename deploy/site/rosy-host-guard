#!/usr/bin/env python3
"""Site host guard for the team PCs and robots (D-530); rosy-host-guard.timer runs it every 10 min.

Generalizes the model PC guard. /etc/rosy/host-guard/hosts.conf (host-local, it has addresses;
see host-guard.conf.example) lists one host per line:

  <name> pc <ssh-target> <quiet HH:MM-HH:MM or ->
  <name> robot <host>:<port>
  <name> updates <ssh-target>           (D-871: only `updates`, e.g. the site PC's own user; no ladder)

A pc answers `health` through its forced command (rosy-host-guard-remote); restart and reboot run
the D-524 Service Control helper there (reboot = shutdown -r +10). Recovery ladder:
GUARD_BAD_CHECKS bad answers in a row -> restart the watched user units that are down (or reboot
when none are down); still bad at twice that count -> reboot. High load alone is only reported
(training is legitimately heavy); it counts only together with memory pressure or a down unit.
At most GUARD_MAX_REBOOTS reboots per host until a healthy check, and GUARD_REBOOT_MIN_GAP_S
between two (persisted in status.json). A refused restart or reboot is logged as refused and the
ladder does not advance as if it had worked. Never inside the host's quiet
window (its nightly reboot; a reboot whose +10 min lands in the window is not sent), never within GUARD_MIN_UPTIME_S of boot. An unreachable pc is only
logged: the hardware watchdog and the host-local rosy-ssh-watchdog own that case. Robots are only
probed on their CORE port; their recovery belongs to D-412 and the rosy-* units.

Every action is appended to <state>/actions.jsonl; <state>/status.json holds the current state.
"""

from __future__ import annotations

import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

CONFIG = Path(os.environ.get("GUARD_CONFIG", "/etc/rosy/host-guard/hosts.conf"))
STATE = Path(os.environ.get("GUARD_STATE", "/var/lib/rosy-host-guard"))
KEY = os.environ.get("GUARD_KEY", "/etc/rosy/host-guard/id_ed25519")
KNOWN = os.environ.get("GUARD_KNOWN_HOSTS", "/etc/rosy/host-guard/known_hosts")
LOCAL_STATUS = Path(os.environ.get("GUARD_LOCAL_STATUS", "/var/lib/rosy-host-state/status.json"))
BAD_CHECKS = int(os.environ.get("GUARD_BAD_CHECKS", "3"))          # 3 x 10 min
MIN_AVAIL_PCT = int(os.environ.get("GUARD_MIN_AVAIL_PCT", "3"))
MAX_SWAP_PCT = int(os.environ.get("GUARD_MAX_SWAP_PCT", "80"))
MAX_LOAD_PER_CORE = float(os.environ.get("GUARD_MAX_LOAD_PER_CORE", "4"))
MIN_UPTIME_S = int(os.environ.get("GUARD_MIN_UPTIME_S", "3600"))
MAX_REBOOTS = int(os.environ.get("GUARD_MAX_REBOOTS", "2"))
REBOOT_MIN_GAP_S = int(os.environ.get("GUARD_REBOOT_MIN_GAP_S", "3600"))
REBOOT_DELAY_MIN = 10  # D-524 helper reboots with shutdown -r +10
# D-883: the rosy-ops lab storage floor. Report only; a reboot does not free a disk.
MIN_DISK_FREE_GB = float(os.environ.get("GUARD_MIN_DISK_FREE_GB", "30"))
MAX_DISK_USE_PCT = int(os.environ.get("GUARD_MAX_DISK_USE_PCT", "90"))
# Report-only RAM warning, well before the MIN_AVAIL_PCT + swap ladder above acts.
WARN_AVAIL_PCT = int(os.environ.get("GUARD_WARN_AVAIL_PCT", "10"))
# D-885: a disk-low lab PC gets one clean-storage request per gap; the site PC keeps product data.
LAB_PCS = ("ai", "model")
CLEAN_GAP_S = int(os.environ.get("GUARD_CLEAN_GAP_S", "21600"))
# The site PC reads its own headroom with the same forced command the other PCs answer.
LOCAL_HEALTH = os.environ.get("GUARD_LOCAL_HEALTH", "/usr/local/sbin/rosy-host-guard-remote")


def now_hhmm() -> str:
    return os.environ.get("GUARD_NOW") or time.strftime("%H:%M")


def in_quiet(window: str, now: str) -> bool:
    if window == "-":
        return False
    start, end = window.split("-")
    return start <= now < end if start <= end else (now >= start or now < end)


def ssh_run(target: str, command: str) -> subprocess.CompletedProcess | None:
    cmd = ["ssh", "-i", KEY, "-o", "BatchMode=yes", "-o", "ConnectTimeout=15",
           "-o", "ServerAliveInterval=10", "-o", f"UserKnownHostsFile={KNOWN}", target, command]
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return None


def ssh(target: str, command: str) -> str | None:
    result = ssh_run(target, command)
    return result.stdout.strip() if result is not None and result.returncode == 0 else None


def remote_action(name: str, target: str, command: str, reason: str) -> bool:
    """Run restart/reboot through the forced command. Logs what really happened; True when accepted."""
    result = ssh_run(target, command)
    if result is not None and result.returncode == 0:
        act(name, command, reason)
        return True
    detail = "timeout" if result is None else f"rc={result.returncode} {result.stderr.strip()[:200]}"
    act(name, f"{command} refused", f"{detail}; {reason}")
    return False


def tcp_ok(address: str) -> bool:
    host, port = address.rsplit(":", 1)
    try:
        with socket.create_connection((host, int(port)), timeout=5):
            return True
    except OSError:
        return False


def act(name: str, action: str, reason: str) -> None:
    print(f"{name}: {action} ({reason})", flush=True)
    with open(STATE / "actions.jsonl", "a", encoding="utf-8") as f:
        f.write(json.dumps({"time": int(time.time()), "host": name, "action": action, "reason": reason}) + "\n")


def plus_minutes(hhmm: str, minutes: int) -> str:
    total = (int(hhmm[:2]) * 60 + int(hhmm[3:]) + minutes) % 1440
    return f"{total // 60:02d}:{total % 60:02d}"


def recovery_report(value):
    """An old, incomplete or corrupt cache is unavailable evidence, never a healthy report."""
    if not isinstance(value, dict) or value.get("role") not in ("site", "model", "ai"):
        return None
    stamp = value.get("time")
    if type(stamp) not in (int, float) or not 0 < stamp < float("inf"):
        return None
    if value.get("state") not in ("ok", "degraded") or not isinstance(value.get("resources"), dict):
        return None
    if not isinstance(value.get("issues"), list):
        return None
    for name in ("watchdog", "kernel", "ssh", "swap"):
        detail = value.get(name)
        if not isinstance(detail, dict) or detail.get("state") not in ("ok", "degraded", "unknown", "missing", "unsupported"):
            return None
    return value


def parse_health(answer: str) -> dict:
    """The forced command's `health` line as resources; raises on a malformed reply."""
    fields = answer.split()
    avail, swap, load, cores, uptime = int(fields[0]), int(fields[1]), float(fields[2]), int(fields[3]), int(fields[4])
    down = [] if len(fields) < 6 or fields[5] == "-" else fields[5].split(",")
    disk = gpu = disk_low = None  # an older forced command sends six fields: unknown, never healthy
    if len(fields) >= 10 and "-" not in fields[6:10]:
        test_kb, test_pct, root_kb, root_pct = (int(f) for f in fields[6:10])
        disk = {"test_free_gb": round(test_kb / 2**20, 1), "test_use_pct": test_pct,
                "root_free_gb": round(root_kb / 2**20, 1), "root_use_pct": root_pct}
        disk_low = (min(test_kb, root_kb) / 2**20 < MIN_DISK_FREE_GB
                    or max(test_pct, root_pct) >= MAX_DISK_USE_PCT)
    if len(fields) >= 14 and "-" not in fields[10:14]:
        gpu = {"used_mib": int(fields[10]), "total_mib": int(fields[11]),
               "util_pct": int(fields[12]), "temp_c": int(fields[13])}
    memory = cpu = None
    if len(fields) >= 16:
        memory = {"total_gb": round(int(fields[14]) / 2**20, 1), "avail_gb": round(int(fields[15]) / 2**20, 1)}
    if len(fields) >= 18:  # display only: no measured threshold yet for a hot or busy PC
        cpu = {"busy_pct": None if fields[16] == "-" else int(fields[16]),
               "temp_c": None if fields[17] == "-" else int(fields[17])}
    memory_low = avail < WARN_AVAIL_PCT
    return {
        "avail_pct": avail, "swap_pct": swap, "load": load,
        "cores": cores, "uptime_s": uptime, "down": down,
        "disk": disk, "disk_low": disk_low, "gpu": gpu, "memory": memory, "memory_low": memory_low,
        "cpu": cpu,
    }


def update_report(text: str | None) -> dict | None:
    """A PC's update channels (D-871). Anything else is no evidence; it never affects the recovery ladder."""
    try:
        value = json.loads(text or "null")
    except ValueError:
        return None
    if (not isinstance(value, dict) or value.get("schema") != "rosy.update-report/1"
            or value.get("gate") not in ("open", "frozen", "missing") or not isinstance(value.get("updaters"), list)
            or type(value.get("time")) is not int):
        return None
    return value


def check_pc(name: str, target: str, quiet: str, entry: dict) -> None:
    entry["recovery"] = None
    entry["updates"] = None
    answer = ssh(target, "health")
    if answer is None:
        entry["state"] = "unreachable"
        entry["resources"] = None  # a missed reply must not keep the previous headroom
        print(f"{name}: unreachable (watchdog's job if it froze)", flush=True)
        return
    resources = parse_health(answer)  # a malformed reply raises here, before any counter changes
    entry["resources"] = resources
    avail, swap, load, cores = (resources[k] for k in ("avail_pct", "swap_pct", "load", "cores"))
    uptime, down, disk = resources["uptime_s"], resources["down"], resources["disk"]
    disk_low, memory_low, memory = resources["disk_low"], resources["memory_low"], resources["memory"]
    try:
        recovery = recovery_report(json.loads(ssh(target, "recovery") or "null"))
        if recovery and (name not in ("site", "model", "ai") or recovery["role"] == name):
            entry["recovery"] = recovery
    except (ValueError, TypeError):
        pass  # Older hosts may not provide recovery yet; resource recovery keeps its existing policy.
    entry["updates"] = update_report(ssh(target, "updates"))  # older hosts: None, shown as unknown
    reasons = []
    if avail < MIN_AVAIL_PCT and swap > MAX_SWAP_PCT:
        reasons.append(f"memory avail {avail}% swap {swap}%")
    if down:
        reasons.append("down " + ",".join(down))
    high_load = load > cores * MAX_LOAD_PER_CORE
    if disk_low and name in LAB_PCS and time.time() - entry.get("last_clean_request", 0) >= CLEAN_GAP_S:
        # D-885: the rosy-ops service decides what goes; a refusal (older PC) waits the same gap.
        entry["last_clean_request"] = int(time.time())
        remote_action(name, target, "clean-storage", f"disk low {disk}")
    elif disk_low:
        print(f"{name}: disk low {disk} (clean-storage requested at {entry.get('last_clean_request')})", flush=True)
    if memory_low:
        print(f"{name}: memory avail {avail}% {memory} (report only, D-883)", flush=True)
    if not reasons:
        state = ("disk-low" if disk_low else "memory-low" if memory_low
                 else "load-high" if high_load else "ok")
        entry.update(state=state, bad=0, restarted=False, reboots=0)
        if high_load:
            print(f"{name}: load {load}/{cores} cores (report only)", flush=True)
        return
    if high_load:
        reasons.append(f"load {load}/{cores} cores")
    entry["bad"] = entry.get("bad", 0) + 1
    entry["state"] = "bad"
    reason = f"{entry['bad']}/{BAD_CHECKS}: " + "; ".join(reasons)
    print(f"{name}: unhealthy {reason}", flush=True)
    if entry["bad"] >= BAD_CHECKS and down and not entry.get("restarted"):
        # restarted stays False when every restart was refused, so the ladder goes on to a reboot
        entry["restarted"] = any([remote_action(name, target, f"restart {unit}", reason) for unit in down])
        if entry["restarted"]:
            return
    if entry["bad"] >= BAD_CHECKS * (2 if entry.get("restarted") else 1):
        if uptime < MIN_UPTIME_S:
            print(f"{name}: would reboot, but it booted {uptime}s ago", flush=True)
            return
        if in_quiet(quiet, plus_minutes(now_hhmm(), REBOOT_DELAY_MIN)):
            print(f"{name}: would reboot, but the delayed reboot lands in its nightly window", flush=True)
            return
        if entry.get("reboots", 0) >= MAX_REBOOTS:
            print(f"{name}: rebooted {entry['reboots']} times without recovery; no reboot", flush=True)
            return
        if time.time() - entry.get("last_reboot", 0) < REBOOT_MIN_GAP_S:
            print(f"{name}: rebooted recently; no reboot", flush=True)
            return
        if remote_action(name, target, "reboot", reason):
            entry.update(bad=0, restarted=False, reboots=entry.get("reboots", 0) + 1, last_reboot=int(time.time()))


def local_health() -> dict | None:
    """This PC's own headroom; unreadable or malformed is absence, never a synthesized healthy row."""
    try:
        done = subprocess.run([LOCAL_HEALTH], env={**os.environ, "SSH_ORIGINAL_COMMAND": "health"},
                              capture_output=True, text=True, timeout=30)
        return parse_health(done.stdout) if done.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError, IndexError):
        return None


def main() -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    status_file = STATE / "status.json"
    try:
        status = json.loads(status_file.read_text(encoding="utf-8")) if status_file.exists() else {}
        if not isinstance(status, dict):
            raise ValueError("status.json is not an object")
    except (OSError, ValueError) as exc:
        # A corrupt state file must not stop the guard for good: start clean. The
        # reboot cap restarts too, but the 1 h gap is re-learned from the next reboot.
        print(f"rosy-host-guard: unreadable {status_file} ({exc}); starting from empty state", file=sys.stderr)
        status = {}
    status = {name: row for name, row in status.items()
              if isinstance(row, dict) and row.get("source") != "local"}
    now = now_hhmm()
    updates_only = {}
    for raw in CONFIG.read_text(encoding="utf-8").splitlines():
        line = raw.split("#", 1)[0].split()
        if not line:
            continue
        if line[1:2] == ["updates"]:  # D-871: update channels only (the site PC itself); never the ladder
            try:
                updates_only[line[0]] = update_report(ssh(line[2], "updates"))
            except Exception as exc:  # noqa: BLE001 - like the other lines, one bad line never stops the rest
                print(f"{line[0]}: updates failed: {exc!r}", flush=True)
            continue
        entry = status.setdefault(line[0], {})
        entry["recovery"] = None
        try:
            name, kind = line[0], line[1]
            if kind == "robot":
                entry["state"] = "ok" if tcp_ok(line[2]) else "unreachable"
            elif kind == "pc":
                if in_quiet(line[3], now):
                    entry["state"] = "quiet"
                    entry["resources"] = None
                else:
                    check_pc(name, line[2], line[3], entry)
            else:
                print(f"{name}: unknown kind {kind}", flush=True)
                continue
        except Exception as exc:  # one bad line or reply must not stop the other hosts
            entry["state"] = "error"
            entry["resources"] = None
            print(f"{line[0]}: check failed: {exc!r}", flush=True)
        entry["time"] = int(time.time())
    try:
        recovery = recovery_report(json.loads(LOCAL_STATUS.read_text(encoding="utf-8")).get("recovery"))
        if recovery:
            row = status[recovery["role"]] = {
                "source": "local",
                "time": recovery.get("time"), "state": recovery.get("state", "error"),
                "resources": recovery.get("resources"), "recovery": recovery,
            }
            local = local_health()
            if local is not None:
                row["resources"] = {**(row["resources"] or {}), **local}
    except (OSError, ValueError, AttributeError):
        pass  # A missing local report is shown as unverified by Fleet, never synthesized as healthy.
    for name, report in updates_only.items():  # after the local report, which replaces the site row
        status.setdefault(name, {"source": "local"})["updates"] = report  # rebuilt every run, like the local row
    tmp = status_file.with_suffix(".tmp")
    tmp.write_text(json.dumps(status, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, status_file)
    return 0


if __name__ == "__main__":
    sys.exit(main())
