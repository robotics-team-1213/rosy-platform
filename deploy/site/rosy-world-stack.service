[Unit]
Description=ROSY World 3D and Real Fleet bridge stack
Requires=docker.service avahi-daemon.service
BindsTo=rosy-site-stack.service
PartOf=rosy-site-stack.service
After=docker.service avahi-daemon.service rosy-site-stack.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/rosy/site/site.env
ExecStart=/usr/bin/docker compose --project-name rosy-world --env-file /etc/rosy/site/site.env -f /etc/rosy/site/compose.world-standalone.yaml up -d --no-build
ExecStop=/usr/bin/docker compose --project-name rosy-world --env-file /etc/rosy/site/site.env -f /etc/rosy/site/compose.world-standalone.yaml down
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=rosy-site-stack.service multi-user.target
