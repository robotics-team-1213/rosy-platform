#!/usr/bin/env bash
# Stable entry point for the D-373 site model watcher (D-427 wave 1, commit 1-pre).
#
#   rosy-model-watch watch --config FILE           # model/watch.py, run by the unit
#   rosy-model-watch doctor --watch-config FILE    # rosy_ml.py doctor
#   rosy-model-watch locate                        # print the perception folder used
#
# install-model-watch.sh installs this file to /opt/rosy/model-watch/bin. The
# source copy (ROSY_MODEL_WATCH_SRC, default /opt/rosy/model-watch/src) resolves
# D-637's registry watcher and operator CLI first. Retained D-427 and pre-D-427
# layouts remain fallback paths for enrolled old checkouts.
set -euo pipefail

SRC=${ROSY_MODEL_WATCH_SRC:-/opt/rosy/model-watch/src}
VENV=${ROSY_MODEL_WATCH_VENV:-/opt/rosy/model-watch/venv}

DIR=
WATCH=
CLI=
if [ -f "$SRC/learning/registry/perception/watch.py" ] && [ -f "$SRC/tools/perception/rosy_ml.py" ]; then
  DIR=$SRC/learning/registry/perception
  WATCH=$DIR/watch.py
  CLI=$SRC/tools/perception/rosy_ml.py
else
  for candidate in "$SRC/learning/training/perception" "$SRC/tools/perception"; do
    if [ -f "$candidate/model/watch.py" ]; then
      DIR=$candidate
      WATCH=$DIR/model/watch.py
      CLI=$DIR/rosy_ml.py
      break
    fi
  done
fi
if [ -z "$DIR" ]; then
  echo "rosy-model-watch: no perception tools (model/watch.py) in the checkout $SRC" >&2
  exit 1
fi

case "${1:-}" in
  watch) shift
    # Host updated before migrate-site-secrets.sh: use the pre-migration token path.
    if [ -n "${HF_TOKEN_FILE:-}" ] && [ ! -e "$HF_TOKEN_FILE" ] && [ -e /etc/rosy/site/secrets/hf_token ]; then
      export HF_TOKEN_FILE=/etc/rosy/site/secrets/hf_token
    fi
    exec "$VENV/bin/python" "$WATCH" "$@" ;;
  doctor) shift; exec "$VENV/bin/python" "$CLI" doctor "$@" ;;
  locate) printf '%s\n' "$DIR" ;;
  *) echo "usage: rosy-model-watch watch|doctor|locate [args...]" >&2; exit 2 ;;
esac
