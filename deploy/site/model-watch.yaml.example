# /etc/rosy/model-watch.yaml (root:rosy-model-watch 0640). D-373 decision 5.
# No secrets here: the HF token is /etc/rosy/site/secrets/hf_token (HF_TOKEN_FILE).
repo: <hf-org>/<model-repo>
robots:
  - name: <robot-name>
    host: <robot-ip>
ssh:
  identity: /etc/rosy/model-watch/rosy-operator-ed25519
  known_hosts: /etc/rosy/model-watch/known_hosts
intake_out: /var/lib/rosy-model-watch/models
state_file: /var/lib/rosy-model-watch/state.json
# Intake replays data/teleop/learning/*.mp4 under this directory.
replay_root: /var/lib/rosy-model-watch/replay
max_new_per_run: 1
history_limit: 20
