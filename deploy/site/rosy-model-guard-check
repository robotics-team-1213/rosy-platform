#!/usr/bin/env bash
# Site host side of the model PC hang guard; rosy-model-guard.timer runs it every 10 min.
# Asks the model PC's forced command for `health`; after GUARD_BAD_CHECKS bad answers in a row
# it asks for `reboot`. An unreachable PC is only logged: a frozen kernel cannot answer SSH,
# and the model PC's hardware watchdog (install-model-pc-guard.sh) restarts it instead.
set -uo pipefail

HOST=${GUARD_HOST:-rosy@100.98.162.71}
KEY=${GUARD_KEY:-/etc/rosy/model-guard/id_ed25519}
STATE=${GUARD_STATE:-/var/lib/rosy-model-guard}
BAD_CHECKS=${GUARD_BAD_CHECKS:-3}          # 3 x 10 min
MIN_AVAIL_PCT=${GUARD_MIN_AVAIL_PCT:-3}
MAX_SWAP_PCT=${GUARD_MAX_SWAP_PCT:-80}
MAX_LOAD_PER_CORE=${GUARD_MAX_LOAD_PER_CORE:-4}
MIN_UPTIME_S=${GUARD_MIN_UPTIME_S:-3600}    # never reboot a PC that booted less than an hour ago
QUIET=${GUARD_QUIET:-05:50-06:20}           # the model PC's own nightly reboot window

mkdir -p "$STATE"
bad_file=$STATE/bad
log() { logger -t rosy-model-guard "$*"; echo "$*"; }

now=$(date +%H:%M)
if [[ "$now" > "${QUIET%-*}" && "$now" < "${QUIET#*-}" ]]; then exit 0; fi

ssh_guard() {
  timeout 60 ssh -i "$KEY" -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=10 \
    -o UserKnownHostsFile=/etc/rosy/model-guard/known_hosts "$HOST" "$1"
}

if ! answer=$(ssh_guard health); then
  log "model PC unreachable (watchdog's job if the kernel froze)"
  exit 0
fi
read -r avail swap load cores uptime <<<"$answer"
bad=0
if (( avail < MIN_AVAIL_PCT && swap > MAX_SWAP_PCT )); then bad=1; fi
if awk -v l="$load" -v c="$cores" -v k="$MAX_LOAD_PER_CORE" 'BEGIN{exit !(l > c*k)}'; then bad=1; fi

if (( bad == 0 )); then
  rm -f "$bad_file"
  exit 0
fi
count=$(( $(cat "$bad_file" 2>/dev/null || echo 0) + 1 ))
echo "$count" > "$bad_file"
log "model PC unhealthy ($count/$BAD_CHECKS): avail ${avail}% swap ${swap}% load $load/$cores cores"
if (( count >= BAD_CHECKS && uptime >= MIN_UPTIME_S )); then
  log "rebooting the model PC"
  ssh_guard reboot || true
  rm -f "$bad_file"
fi
