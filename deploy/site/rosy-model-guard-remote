#!/bin/sh
# Forced command for the site host's model guard key on the model PC (authorized_keys
# `command=`). It answers `health` and runs `reboot`; nothing else. Installed by
# install-model-pc-guard.sh as /usr/local/sbin/rosy-model-guard-remote.
set -eu
case "${SSH_ORIGINAL_COMMAND:-health}" in
  health)
    # avail% swap_used% load1 cores uptime_s
    awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} /^SwapTotal:/{st=$2} /^SwapFree:/{sf=$2}
         END {printf "%d %d ", 100*a/t, (st ? 100*(st-sf)/st : 0)}' /proc/meminfo
    printf '%s %s %s\n' "$(cut -d' ' -f1 /proc/loadavg)" "$(nproc)" "$(cut -d. -f1 /proc/uptime)"
    ;;
  reboot)
    logger -t rosy-model-guard "reboot requested by the site host guard"
    exec sudo -n /usr/bin/systemctl reboot
    ;;
  *)
    echo "refused: $SSH_ORIGINAL_COMMAND" >&2
    exit 2
    ;;
esac
