FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/rosy-venv/bin:$PATH \
    PYTHONPATH=/opt/rosy/src/site/overhead:/opt/rosy/src/site/games:/opt/rosy/src/contracts/foundation

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 rosy \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin rosy \
    && install -d -o 10001 -g 10001 /opt/rosy/src/site/overhead \
       /opt/rosy/src/site/games /opt/rosy/src/contracts/foundation

COPY deploy/site/requirements-vision.txt /opt/rosy/requirements.txt
COPY deploy/site/secret_exec.py /opt/rosy/secret_exec.py
COPY src/site/overhead/overhead/ /opt/rosy/src/site/overhead/overhead/
COPY src/site/overhead/setup.py /opt/rosy/src/site/overhead/setup.py
COPY src/site/games/games/ /opt/rosy/src/site/games/games/
COPY src/site/games/setup.py /opt/rosy/src/site/games/setup.py
COPY src/contracts/foundation/core_common/ /opt/rosy/src/contracts/foundation/core_common/

RUN python3 -m venv /opt/rosy-venv \
    && /opt/rosy-venv/bin/pip install --no-cache-dir -r /opt/rosy/requirements.txt \
    && rm /opt/rosy/requirements.txt

WORKDIR /opt/rosy
EXPOSE 8095
USER 0:0
ENTRYPOINT ["python3", "/opt/rosy/secret_exec.py"]
CMD ["--", "python3", "-m", "overhead.cli", "vision", "--config", "/run/rosy-config/site-cameras.yaml", "--host", "0.0.0.0", "--port", "8095"]
