# Private copy: replace every device identity and digest with observed/accepted values.
# Digests below are placeholders, not hashes of usable credentials.
schema: rosy.workcell-observations/1
workcells:
  - workcell_id: example_bench
    label: Dual follower workcell
    arms:
      - source_id: example_arm_a
        arm_id: arm_a
        label: Arm A
        board_id: EXAMPLE-BOARD-A
        joint_topic: /omx_commissioning/arm_a/joint_states
        joint_names: [joint1, joint2, joint3, joint4, joint5, gripper_joint_1]
        token_env: ROSY_ARM_A_TOKEN
        credential_sha256: '1111111111111111111111111111111111111111111111111111111111111111'
      - source_id: example_arm_b
        arm_id: arm_b
        label: Arm B
        board_id: EXAMPLE-BOARD-B
        joint_topic: /omx_commissioning/arm_b/joint_states
        joint_names: [joint1, joint2, joint3, joint4, joint5, gripper_joint_1]
        token_env: ROSY_ARM_B_TOKEN
        credential_sha256: '2222222222222222222222222222222222222222222222222222222222222222'
    cameras:
      - source_id: example_overhead
        label: Overhead
        role: overhead
        arm_id: null
        image_topic: /top_camera/image_raw
        device_path: /dev/v4l/by-path/example-overhead-video-index0
        token_env: ROSY_CAMERA_OVERHEAD_TOKEN
        credential_sha256: '3333333333333333333333333333333333333333333333333333333333333333'
      - source_id: example_wrist_a
        label: Arm A wrist
        role: wrist
        arm_id: arm_a
        image_topic: /arm_a_wrist_camera/image_raw
        device_path: /dev/v4l/by-path/example-wrist-a-video-index0
        token_env: ROSY_CAMERA_WRIST_A_TOKEN
        credential_sha256: '4444444444444444444444444444444444444444444444444444444444444444'
      - source_id: example_wrist_b
        label: Arm B wrist
        role: wrist
        arm_id: arm_b
        image_topic: /front_camera/image_raw
        device_path: /dev/v4l/by-path/example-wrist-b-video-index0
        token_env: ROSY_CAMERA_WRIST_B_TOKEN
        credential_sha256: '5555555555555555555555555555555555555555555555555555555555555555'
