#!/bin/bash
# Finish configuring and later upgrade the Ubuntu docker.io engine.
# Never install docker-ce, and never configure ubuntu-fan: its first
# configure enables a FAN bridge this host does not use.
set -euo pipefail
exec 9>"${ROSY_HOST_UPDATE_LOCK:-/run/lock/rosy-host-update.lock}"
if ! flock -n 9; then
  echo "rosy-docker-upgrade: lock held"
  exit 0
fi
export DEBIAN_FRONTEND=noninteractive

packages=(runc containerd docker.io)
for package in docker-compose-v2 docker-buildx docker-buildx-plugin docker-compose-plugin; do
  if [ "$(dpkg-query -W -f '${db:Status-Status}\n' "$package" 2>/dev/null || true)" = "installed" ]; then
    packages+=("$package")
  fi
done

echo "rosy-docker-upgrade: before"
dpkg-query -W -f '${Package} ${db:Status-Abbrev} ${Version}\n' "${packages[@]}"

for package in runc containerd docker.io; do
  state=$(dpkg-query -W -f '${db:Status-Status}' "$package")
  if [ "$state" != "installed" ]; then
    echo "rosy-docker-upgrade: configure $package ($state)"
    dpkg --configure "$package"
  fi
done

apt-get update -qq
workdir="${ROSY_DOCKER_DEBS_DIR:-/var/lib/rosy-site/docker-debs}"
rm -rf "$workdir"
mkdir -p "$workdir"
upgrade_packages=()
for package in "${packages[@]}"; do
  installed=$(dpkg-query -W -f '${Version}' "$package")
  candidate=$(apt-cache policy "$package" | awk '/Candidate:/ {print $2; exit}')
  if [ -n "$candidate" ] && [ "$candidate" != "(none)" ] && dpkg --compare-versions "$candidate" gt "$installed"; then
    echo "rosy-docker-upgrade: $package $installed -> $candidate"
    upgrade_packages+=("$package")
  fi
done
if [ "${#upgrade_packages[@]}" -gt 0 ]; then
  (
    cd "$workdir"
    apt-get download "${upgrade_packages[@]}"
    dpkg -i ./*.deb
  )
else
  echo "rosy-docker-upgrade: already current"
fi
rm -rf "$workdir"

echo "rosy-docker-upgrade: after"
dpkg-query -W -f '${Package} ${db:Status-Abbrev} ${Version}\n' "${packages[@]}"
docker version --format 'docker server {{.Server.Version}}'
