# D-530 site PC desired state (role: site). Format: deploy/hosts/common/host-state/manifest.
# Firewall, stack and Wi-Fi lines touch the network: install applies them only with --approve firewall / wifi.
# Nightly reboot and Docker upgrade were copied byte for byte from the site PC on 2026-10-09.
safe file /etc/systemd/system/rosy-nightly-reboot.timer role/rosy-nightly-reboot.timer
safe file /etc/systemd/system/rosy-nightly-reboot.service role/rosy-nightly-reboot.service
safe enabled rosy-nightly-reboot.timer
safe file /etc/systemd/system/rosy-docker-upgrade.timer role/rosy-docker-upgrade.timer
safe file /etc/systemd/system/rosy-docker-upgrade.service role/rosy-docker-upgrade.service
safe file /usr/local/sbin/rosy-docker-upgrade role/rosy-docker-upgrade 0755
safe enabled rosy-docker-upgrade.timer
safe enabled rosy-site-autoupdate.timer
safe enabled rosy-site-firewall-check.timer
approval=firewall enabled rosy-site-firewall.service
approval=firewall enabled rosy-site-stack.service
approval=wifi wifi-allow
safe file /etc/systemd/system/rosy-host-guard.service role/rosy-host-guard.service
safe file /etc/systemd/system/rosy-host-guard.timer role/rosy-host-guard.timer
report enabled rosy-host-guard.timer
approval disabled rosy-site-update.timer
approval file /etc/systemd/system/rosy-watchdog-load.service common/rosy-watchdog-load.service
approval enabled rosy-watchdog-load.service
approval file /etc/systemd/system.conf.d/rosy-watchdog.conf common/rosy-watchdog.conf
approval file /etc/sysctl.d/90-rosy-hang.conf common/90-rosy-hang.conf
