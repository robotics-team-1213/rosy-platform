[Unit]
Description=Upgrade the Ubuntu Docker engine used by the ROSY site
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecCondition=/usr/local/sbin/rosy-host-control nightly-gate
ExecStart=/usr/local/sbin/rosy-docker-upgrade
TimeoutStartSec=1800
Nice=10
