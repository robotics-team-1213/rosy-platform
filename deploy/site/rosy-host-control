#!/usr/bin/env bash
# Local helper for Service Control (D-524). Fleet calls this with one allowlisted action.
# It does not accept a process name, a signal, or a shell string.
# Reboot is shutdown -r +10. shutdown -c cancels it.
# ROSY_HOST_CONTROL_ROLE is site, ai, or model.
# ROSY_HOST_CONTROL_PRINT=1 prints the command and does not run it.
set -euo pipefail

ROLE=${ROSY_HOST_CONTROL_ROLE:-}
ACTION=${1:-}
UNIT=${2:-}
if [ -n "${3:-}" ]; then
  echo "refused" >&2
  exit 2
fi

run() {
  if [ -n "${ROSY_HOST_CONTROL_PRINT:-}" ]; then
    printf '%s\n' "$*"
    return 0
  fi
  command "$@"
}

case "$ROLE:$ACTION:$UNIT" in
  site:reboot:|ai:reboot:|model:reboot:)
    run shutdown -r +10 "Rosy control will reboot this host in 10 minutes."
    ;;
  site:cancel-reboot:|ai:cancel-reboot:|model:cancel-reboot:)
    run shutdown -c
    ;;
  site:stop-unit:docker.service)
    run systemctl stop docker.service
    ;;
  site:restart-unit:docker.service)
    run systemctl restart docker.service
    ;;
  site:stop-unit:rosy-site-stack.service)
    run systemctl stop rosy-site-stack.service
    ;;
  site:restart-unit:rosy-site-stack.service)
    run systemctl restart rosy-site-stack.service
    ;;
  site:stop-unit:rosy-site-firewall.service)
    run systemctl stop rosy-site-firewall.service
    ;;
  site:restart-unit:rosy-site-firewall.service)
    run systemctl restart rosy-site-firewall.service
    ;;
  ai:stop-unit:pinky-backend.service)
    run systemctl --user --machine=ai@ stop pinky-backend.service
    ;;
  ai:restart-unit:pinky-backend.service)
    run systemctl --user --machine=ai@ restart pinky-backend.service
    ;;
  ai:stop-unit:pinky-frontend.service)
    run systemctl --user --machine=ai@ stop pinky-frontend.service
    ;;
  ai:restart-unit:pinky-frontend.service)
    run systemctl --user --machine=ai@ restart pinky-frontend.service
    ;;
  ai:stop-unit:pinky-nav2.service)
    run systemctl --user --machine=ai@ stop pinky-nav2.service
    ;;
  ai:restart-unit:pinky-nav2.service)
    run systemctl --user --machine=ai@ restart pinky-nav2.service
    ;;
  ai:stop-unit:pinky-rosbridge-d12.service)
    run systemctl --user --machine=ai@ stop pinky-rosbridge-d12.service
    ;;
  ai:restart-unit:pinky-rosbridge-d12.service)
    run systemctl --user --machine=ai@ restart pinky-rosbridge-d12.service
    ;;
  ai:stop-unit:pinky-rosbridge-d13.service)
    run systemctl --user --machine=ai@ stop pinky-rosbridge-d13.service
    ;;
  ai:restart-unit:pinky-rosbridge-d13.service)
    run systemctl --user --machine=ai@ restart pinky-rosbridge-d13.service
    ;;
  ai:stop-unit:pinky-r2-watch.service)
    run systemctl --user --machine=ai@ stop pinky-r2-watch.service
    ;;
  ai:restart-unit:pinky-r2-watch.service)
    run systemctl --user --machine=ai@ restart pinky-r2-watch.service
    ;;
  *)
    echo "refused" >&2
    exit 2
    ;;
esac
