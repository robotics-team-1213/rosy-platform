#!/usr/bin/env bash
# Service Control helper (D-524), installed root-owned as /usr/local/sbin/rosy-host-control.
# Runs only through `sudo -n` (sudoers drop-in from install-host-control.sh, no SETENV, no
# env_keep). The role (site, ai, or model) comes from the root-owned
# /etc/rosy/host-control/role and the account that owns the AI user units from
# /etc/rosy/host-control/units-user, never from the environment. It does not accept a process name,
# a signal, or a shell string.
#   reboot          shutdown -r +10, refused (exit 3) while any reboot is already scheduled and
#                   (exit 6) while an OMX arm session holds its lock. The caller is the guard's ladder
#                   or a person who already saw the running jobs.
#   reboot-if-free  the same, also refused (exit 7) while a job or a busy hold is live on this PC
#   recheck-reboot  this helper's own timer, 30 s before the reboot: cancels the reboot it scheduled
#                   if an arm session began during the delay. Not reachable from the SSH keys.
#   cancel-reboot   shutdown -c, only for the reboot this helper scheduled (else exit 4); the
#                   nightly window reboot and unattended-upgrades are never cancelled here
#   restart-unit U  systemctl --no-block restart U (allowlisted U). No unit can be stopped (D-991).
#                   A cell camera unit is refused (exit 6) while an arm session runs.
#   install-site-config N  copy ~SUDO_USER/.rosy/site-incoming/N to /etc/rosy/site/N (site role,
#                   allowlisted N, read as SUDO_USER so a symlink reaches nothing more than that
#                   account can read, YAML-checked, 64 KiB cap, previous copy kept under
#                   /var/lib/rosy-host-control/backup). Not reachable from the Fleet key.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

CONF=/etc/rosy/host-control
SCHEDULED=/run/systemd/shutdown/scheduled   # logind's record of a pending shutdown -r
STATE=/run/rosy-host-control                # tmpfs: the marker disappears with the reboot
SITE_CONF=/etc/rosy/site
BACKUP=/var/lib/rosy-host-control/backup
HOME_ROOT=/home
RECHECK_AFTER_S=570                         # shutdown -r +10 is 600 s
ACTION=${1:-}
UNIT=${2:-}
ROLE=$(cat "$CONF/role" 2>/dev/null || true)

log() { logger -t rosy-host-control "role=$ROLE action=$ACTION unit=$UNIT by=${SUDO_USER:-root} $*"; }
refuse() { log "result=refused($1)"; echo "refused: $1" >&2; exit "${2:-2}"; }
scheduled_usec() { sed -n 's/^USEC=//p' "$SCHEDULED" 2>/dev/null || true; }

# The lock the nightly reboot yields to (rosy-nightly-reboot.service), read from /proc/locks. These
# files are users': root never opens one, because a FIFO would hang this helper inside its own lock,
# and a probing flock would make a session starting that instant fail (cell_params_web.session_busy).
arm_session_held() {
  local lock inode
  [ -r /proc/locks ] || return 0  # unknown is not free
  for lock in "$HOME_ROOT"/*/rosy-omx/session.lock; do
    inode=$(stat -L -c %i -- "$lock" 2>/dev/null) || continue
    if grep -q ":$inode " /proc/locks; then return 0; fi
  done
  return 1
}

# The first word of a user's job file, bounded: a regular file only, 64 bytes, 2 s if it is swapped.
first_word() {
  local text
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  text=$(timeout 2 head -c 64 -- "$1" 2>/dev/null) || return 1
  printf '%s' "${text%%[[:space:]]*}"
}

# The same files host_probe.py counts: <pid> <class> <cores> <GB> locks, <expiry> <class> <cores> <GB>
# reservations (a supervised Isaac run holds only one), and busy. Nothing read is evaluated.
jobs_live() {
  local file word boot now
  now=$(date +%s)
  boot=$(awk '/^btime /{print $2}' /proc/stat)
  for file in "$HOME_ROOT"/*/rosy-jobs/*.lock; do
    word=$(first_word "$file") || continue
    [[ "$word" =~ ^[1-9][0-9]{0,6}$ ]] && [ "$word" -gt 1 ] || continue
    [ "$(stat -c %Y -- "$file")" -ge "$boot" ] || continue  # the pid is from before this boot
    if kill -0 "$word" 2>/dev/null; then return 0; fi
  done
  for file in "$HOME_ROOT"/*/rosy-jobs/*.resv; do
    word=$(first_word "$file") || continue
    [[ "$word" =~ ^[0-9]{10,12}$ ]] && [ "$word" -gt "$now" ] && return 0
  done
  for file in "$HOME_ROOT"/*/rosy-jobs/busy; do
    word=$(first_word "$file") || continue
    # "<expiry epoch> <owner> <pid>" or a bare touch, which ends with the boot.
    if [[ "$word" =~ ^[0-9]{10,12}$ ]]; then
      [ "$word" -le "$now" ] || return 0
    elif [ "$(stat -c %Y -- "$file")" -ge "$boot" ]; then
      return 0
    fi
  done
  return 1
}

restart_user_unit() {
  local owner
  owner=$(cat "$CONF/units-user" 2>/dev/null || true)
  [[ "$owner" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || refuse "units-user is not set"
  timeout 20 systemctl --user --machine="$owner@" --no-block restart "$UNIT"
}

schedule_reboot() {
  [ -z "$(scheduled_usec)" ] || refuse "a reboot is already scheduled" 3
  if arm_session_held; then refuse "an arm session is running" 6; fi
  # Armed first: a reboot nobody re-checks could cut a session that starts during the delay.
  systemd-run --quiet --on-active="$RECHECK_AFTER_S" --unit="rosy-host-control-recheck-$(date +%s%N)" \
    /usr/local/sbin/rosy-host-control recheck-reboot || refuse "cannot arm the session re-check"
  shutdown -r +10 "Rosy Service Control will reboot this host in 10 minutes."
  scheduled_usec > "$STATE/reboot"
}

[ $# -le 2 ] || refuse "arguments"
mkdir -p -m 0700 "$STATE"
exec 9>"$STATE/lock"
flock 9

case "$ROLE:$ACTION:$UNIT" in
  site:reboot:|ai:reboot:|model:reboot:)
    schedule_reboot
    ;;
  site:reboot-if-free:|ai:reboot-if-free:|model:reboot-if-free:)
    [ -z "$(scheduled_usec)" ] || refuse "a reboot is already scheduled" 3
    if arm_session_held; then refuse "an arm session is running" 6; fi
    if jobs_live; then refuse "a job is running on this PC" 7; fi
    schedule_reboot
    ;;
  site:recheck-reboot:|ai:recheck-reboot:|model:recheck-reboot:)
    mine=$(cat "$STATE/reboot" 2>/dev/null || true)
    if [ -n "$mine" ] && [ "$mine" = "$(scheduled_usec)" ] && arm_session_held; then
      shutdown -c "Rosy Service Control: an arm session began, the reboot is cancelled."
      rm -f "$STATE/reboot"
      log "result=cancelled(arm session)"
    fi
    ;;
  site:cancel-reboot:|ai:cancel-reboot:|model:cancel-reboot:)
    mine=$(cat "$STATE/reboot" 2>/dev/null || true)
    [ -n "$mine" ] && [ "$mine" = "$(scheduled_usec)" ] || refuse "no reboot scheduled by Service Control" 4
    shutdown -c
    rm -f "$STATE/reboot"
    ;;
  site:restart-unit:docker.service|\
  site:restart-unit:rosy-site-stack.service|\
  site:restart-unit:rosy-site-firewall.service)
    systemctl --no-block restart "$UNIT"
    ;;
  site:restart-unit:rosy-omx-camera-readiness.service|\
  site:restart-unit:rosy-omx-camera-view.service|\
  site:restart-unit:rosy-omx-camera@arm_a_wrist.service|\
  site:restart-unit:rosy-omx-camera@top.service)
    if arm_session_held; then refuse "an arm session is running" 6; fi
    restart_user_unit
    ;;
  ai:restart-unit:rosy-situation.service|\
  model:restart-unit:rosy-dataset-review-account.service|\
  model:restart-unit:rosy-dataset-review.service|\
  model:restart-unit:rosy-edge-review.service|\
  model:restart-unit:rosy-ollama.service|\
  model:restart-unit:rosy-review-v12.service|\
  model:restart-unit:rosy-review-v13-eval.service|\
  model:restart-unit:rosy-review-v13.service|\
  model:restart-unit:rosy-tensorboard.service)
    restart_user_unit
    ;;
  ai:clean-storage:|model:clean-storage:)
    # D-883: start the rosy-ops lab storage service once; host_storage.py owns what is kept.
    owner=$(cat "$CONF/units-user" 2>/dev/null || true)
    [[ "$owner" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || refuse "units-user is not set"
    # systemd refuses `cat` over --machine ("Cannot remotely cat units."); LoadState works there.
    [ "$(timeout 20 systemctl --user --machine="$owner@" show -p LoadState --value rosy-test-storage.service 2>/dev/null)" = loaded ] \
      || refuse "no rosy-test-storage.service" 5
    timeout 20 systemctl --user --machine="$owner@" --no-block start rosy-test-storage.service
    ;;
  site:install-site-config:fleet-site.yaml|\
  site:install-site-config:site-cameras.yaml)
    [[ "${SUDO_USER:-}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && [ "$SUDO_USER" != root ] || refuse "no login user"
    home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    [ -n "$home" ] || refuse "no home"
    tmp=$(mktemp "$SITE_CONF/.$UNIT.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    runuser -u "$SUDO_USER" -- head -c 65537 -- "$home/.rosy/site-incoming/$UNIT" > "$tmp" || refuse "cannot read incoming file"
    [ "$(stat -c %s "$tmp")" -le 65536 ] || refuse "file larger than 64 KiB"
    python3 -c 'import sys, yaml; yaml.safe_load(open(sys.argv[1], encoding="utf-8"))' "$tmp" || refuse "not valid YAML"
    if [ -e "$SITE_CONF/$UNIT" ]; then
      backup=$BACKUP/$(date +%Y%m%dT%H%M%S)-$UNIT
      mkdir -p -m 0700 "$BACKUP"
      cp -a "$SITE_CONF/$UNIT" "$backup"
      log "backup=$backup"
    fi
    chown root:root "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$SITE_CONF/$UNIT"
    trap - EXIT
    ;;
  *)
    refuse "not allowlisted"
    ;;
esac
log "result=accepted"
echo accepted
