[Unit]
Description=Push new perception models from the store inbox to robot shadow slots (D-373)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# A non-zero exit is a failure and must stay visible: no SuccessExitStatus, no Restart.
# watch.py exits 77 (host name did not resolve), 78 (refused / timed out) or 79 (host
# key unknown or changed) for a robot it cannot reach: `systemctl status` shows failed,
# the journal has one line per robot, and the timer (OnUnitInactiveSec, a failed
# oneshot counts as inactive) fires again.
User=rosy-model-watch
Group=rosy-model-watch
StateDirectory=rosy-model-watch
StateDirectoryMode=0750
WorkingDirectory=/var/lib/rosy-model-watch
Environment=HF_TOKEN_FILE=/etc/rosy/site/secrets/hf_token
Environment=HF_HOME=/var/lib/rosy-model-watch/hf
ExecStart=/opt/rosy/model-watch/venv/bin/python /opt/rosy/model-watch/src/tools/perception/model/watch.py --config /etc/rosy/model-watch.yaml
TimeoutStartSec=6h
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
