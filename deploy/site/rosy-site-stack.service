[Unit]
Description=ROSY Site Fleet, Vision, and HTTPS proxy stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Wants=rosy-site-firewall.service
After=rosy-site-firewall.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rosy/candidate/deploy/site
# Refuse to start on a bind address this host no longer owns, a LAN bind without its
# interface filter, or a site certificate that fails strict verification for tls_host.
ExecStartPre=/usr/bin/python3 /opt/rosy/candidate/deploy/site/site-firewall.py check --verify-certs --env-file /etc/rosy/site/site.env --compose-file /opt/rosy/candidate/deploy/site/compose.yaml
ExecStart=/usr/bin/docker compose --project-name rosy-site --env-file /etc/rosy/site/site.env -f /opt/rosy/candidate/deploy/site/compose.yaml up -d --no-build
ExecStop=/usr/bin/docker compose --project-name rosy-site --env-file /etc/rosy/site/site.env -f /opt/rosy/candidate/deploy/site/compose.yaml down
TimeoutStartSec=180
TimeoutStopSec=120
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
