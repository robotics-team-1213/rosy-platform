# 현장 Fleet 선택 설정(D-525 가상 신호등). 없으면 Fleet은 기본값으로 뜬다.
# 설치: sudo install -m 0644 -o root -g root fleet-site.yaml /etc/rosy/site/fleet-site.yaml
# 소유자 root, 모드 0644. 다음 Fleet 재시작 때 적용된다.
#
# authority는 false로 둔다(D-550 J2 경고만). 신호등은 화면 표시용이고 로봇을 막지 않는다.
# 새로 뜬 Fleet은 전부 적색에서 시작한다. 운영자가 콘솔에서 자동(cycle)을 눌러야 돈다.
fleet:
  lane_compliance:         # D-511 개정 4 / D-607 (b): 역주행 제자리 회전은 링 진입 네 자리에서만(회전 원 0.0926 m,
    turn_spots:            # 원 가장자리가 칠한 선을 테이프 폭 0.025 m까지 넘을 수 있다, D-344 §12 IR 가운데 면제)
      - {x: -0.213, y: 0.221}
      - {x: -0.519, y: 0.201}
      - {x: -0.524, y: -0.242}
      - {x: -0.214, y: -0.264}
    turn_spot_tolerance_m: 0.018   # D-587 자세 한계
  stuck_resolver:          # D-577 개정 2026-10-10: 판단기가 Fleet 등록 자격으로 답할 등록 로봇(로봇별 승인)
    enrolled_robots: [rosy_40, rosy_41]
  traffic:
    zones:
      roundabout:            # map_v2_fleet v5(deploy/site/site-maps), 반시계 일방 순환로 + 빗금까지 잇는 차로 넷
        edges: [ring_n, ring_s, ring_e, ring_w, ring_in_ne, ring_in_sw, ring_out_nw, ring_out_se]
        capacity: 1
    signals:
      sig_ring:
        zone: roundabout
        phases:              # 실제 입구 둘(북동·남서 빗금). 북서·남동 빗금은 일방 고리의 출구다
          - {approach: "east:fwd", green_s: 8}
          - {approach: "west:fwd", green_s: 8}
        yellow_s: 2
        all_red_s: 1
