[Unit]
Description=Publish ROSY LAN mDNS observations to site Fleet
Wants=avahi-daemon.service
After=network-online.target avahi-daemon.service rosy-site-firewall.service

[Service]
Type=oneshot
User=rosy-mdns
Group=rosy-mdns
# Only ROSY_SITE_TLS_HOST and ROSY_SITE_HTTPS_PORT, written from `docker compose config` by
# site-firewall.py apply (rosy-site-firewall.service); no LAN address.
EnvironmentFile=/run/rosy-site/site-public.env
ExecStart=/usr/bin/python3 /opt/rosy/site/mdns-bridge.py --ca-file /etc/rosy/site-secrets/site-ca.crt --token-file /etc/rosy/site-secrets/discovery_token
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The scan goes only to the local proxy over loopback; Avahi is reached over D-Bus (AF_UNIX).
IPAddressDeny=any
IPAddressAllow=localhost
