# Copy to /etc/rosy/site/account-tls.env (root:root, 0600) for rosy-site-account-tls-renew.service.
# Data folder for the renewed pair and its backups: root-only, outside the release.
ROSY_ACCOUNT_TLS_CERTS=/var/lib/rosy/account-tls
# The approved Account DNS name (same as ROSY_ACCOUNT_HTTPS_HOST in site.env).
ROSY_ACCOUNT_TLS_DOMAIN=
