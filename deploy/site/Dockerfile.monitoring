# D-1001: Monitoring has its own signed image, so a Fleet-image defect cannot take down the observer.
# No fleet package, no Fleet state; only the monitoring source and the two protocol modules it reads.
FROM ubuntu:24.04 AS assets
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
COPY operations/monitoring/src/ /source/operations/monitoring/
COPY applications/monitoring/web/ /source/applications/monitoring/web/
COPY shared/web/ /source/shared/web/
RUN PYTHONPATH=/source/operations/monitoring python3 -m rosy.monitoring.web_assets --repo /source --output /monitoring-web

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH=/opt/rosy-venv/bin:$PATH \
    PYTHONPATH=/opt/rosy/src/operations/monitoring:/opt/rosy/src/contracts/foundation
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 rosy \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin rosy \
    && install -d -o 10001 -g 10001 -m 0700 /var/lib/rosy-monitoring
COPY deploy/site/requirements-monitoring.txt /opt/rosy/requirements.txt
COPY deploy/site/secret_exec.py /opt/rosy/secret_exec.py
RUN python3 -m venv /opt/rosy-venv \
    && pip install --no-cache-dir -r /opt/rosy/requirements.txt \
    && rm /opt/rosy/requirements.txt
COPY operations/monitoring/src/ /opt/rosy/src/operations/monitoring/
COPY contracts/foundation/core_common/__init__.py /opt/rosy/src/contracts/foundation/core_common/__init__.py
COPY contracts/foundation/core_common/protocol/__init__.py contracts/foundation/core_common/protocol/connect_reason.py contracts/foundation/core_common/protocol/monitoring.py /opt/rosy/src/contracts/foundation/core_common/protocol/
COPY --from=assets /monitoring-web /opt/rosy/monitoring-web
RUN python3 -c "import rosy.monitoring.service, rosy.monitoring.sources"
WORKDIR /opt/rosy
EXPOSE 8786
# secret_exec drops to uid 10001 after reading the mounted keys (compose adds SETUID/SETGID only).
USER 0:0
ENTRYPOINT ["python3", "/opt/rosy/secret_exec.py"]
