{
	admin localhost:2019
}

# The signed optional Account overlay mounts its frontend here.
import /etc/caddy/account/*.caddy

:{$ROSY_SITE_HTTPS_PORT} {
	tls /run/secrets/site_cert /run/secrets/site_key

	@lan_camera {
		remote_ip private_ranges
		path /api/fleet/vision/sources /api/fleet/vision/lease
	}
	@camera path /overhead/v1/frames
	@vision_preview path /api/vision/sources/*
	route {
		handle /.well-known/assetlinks.json {
			root * /run/rosy-account-public
			rewrite * /assetlinks.json
			header Content-Type application/json
			file_server
		}
		reverse_proxy @lan_camera https://fleet:{$ROSY_FLEET_PORT} {
			header_up X-Rosy-Lan-Camera 1
			transport http {
				tls_trust_pool file /run/secrets/site_ca
				tls_server_name fleet
			}
		}
		reverse_proxy @camera https://vision:{$ROSY_VISION_PORT} {
			transport http {
				tls_trust_pool file /run/secrets/site_ca
				tls_server_name vision
			}
		}
		reverse_proxy @vision_preview https://vision:{$ROSY_VISION_PORT} {
			transport http {
				tls_trust_pool file /run/secrets/site_ca
				tls_server_name vision
			}
		}
		reverse_proxy https://fleet:{$ROSY_FLEET_PORT} {
			header_up -X-Rosy-Lan-Camera
			transport http {
				tls_trust_pool file /run/secrets/site_ca
				tls_server_name fleet
			}
		}
	}
}
