[Unit]
Description=Recover local Pilot recordings and register pending Learning inputs

[Service]
Type=oneshot
EnvironmentFile=%h/.config/rosy/pilot-process.env
Environment=PYTHONPATH=%h/.local/share/rosy/model-code/current/learning/curation/perception:%h/.local/share/rosy/model-code/current/tools/perception:%h/.local/share/rosy/model-code/current/learning/registry/perception:%h/.local/share/rosy/model-code/current/learning/training/perception:%h/.local/share/rosy/model-code/current/middleware/perception
ExecStartPre=/usr/bin/test -f %h/.local/share/rosy/model-code/current/learning/curation/perception/pilot_review.py
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 %t/rosy-pilot-collection.lock %h/rosy-ml/.venv/bin/python %h/.local/share/rosy/model-code/current/learning/curation/perception/pilot_review.py --raw-root ${RAW_ROOT} --video-dir ${VIDEO_ROOT} --out ${REVIEW_ROOT} --classes ${REVIEW_CLASSES} --state ${REVIEW_STATE}
SuccessExitStatus=75
