[Unit]
Description=Deliver sealed review exports and fresh current decisions locally
After=rosy-review-v13.service

[Service]
Type=oneshot
ExecStart=%h/rosy-ml/.venv/bin/python -I %h/.local/lib/rosy-model-code/rosy_model_code.py --config %h/.config/rosy/model-code.json exec training/review_bridge.py %h/.config/rosy/review-pipeline/bridge.json --out %h/rosy-ml/review-pipeline/bridge-state --once
