[Unit]
Description=Verify and import finished Pilot recordings from Pinky %i

[Service]
Type=oneshot
ExecStartPre=/usr/bin/test -s %h/.config/rosy/pilot-%i.operator-token
ExecStartPre=/usr/bin/test -r %h/rosy-ml/%i-ca.pem
ExecStartPre=/usr/bin/test -f %h/.local/share/rosy/model-code/current/learning/curation/perception/fetch_http.py
Environment=ROBOT_BASE_URL=https://rosy-pinky-%i.local:8080
EnvironmentFile=%h/.config/rosy/pilot-%i.env
# The existing model-code executor pins the release and holds its work lock through completion.
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 %t/rosy-pilot-collection.lock %h/rosy-ml/.venv/bin/python -I %h/.local/lib/rosy-model-code/rosy_model_code.py --config %h/.config/rosy/model-code.json exec dataset/fetch_http.py ${ROBOT_BASE_URL} --token-file %h/.config/rosy/pilot-%i.operator-token --ca-file %h/rosy-ml/%i-ca.pem --dest %h/rosy-ml/rosy-platform/data/perception/raw --video-out %h/rosy-ml/rosy-platform/data/teleop/learning --codec h264 --since-id ${SINCE_ID}
SuccessExitStatus=75
