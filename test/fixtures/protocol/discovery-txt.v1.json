{
  "version": 1,
  "doc": "D-370 5.1 shared DNS-SD TXT vectors. Machine source for every discovery parser (core_common discovery_txt, deploy/site copies, Fleet server row check, Android OverheadServiceRecord). docs/reference/site-lan-discovery-profile.md is the human description; test/test_discovery_txt_profile_parity.py keeps them equal. Inputs: service_type, host (resolved .local name or null when the caller has none), address (resolved IP or null), port, txt (ordered key=value items; duplicates are meaningful). Expect: accepted + legacy, or a rejection reason from `reasons`. Unknown keys are ignored.",
  "reasons": [
    "wrong_type", "missing_key", "duplicate_key", "value_mismatch", "bad_host",
    "bad_address", "bad_port", "tls_host_mismatch", "ap_mode"
  ],
  "profile": {
    "_rosy._tcp": {
      "role_column": "로봇",
      "required": {"product": "rosy", "role": "robot", "proto": "core-v1", "tls": "none"},
      "optional": ["name", "stage", "release", "network", "pair"],
      "legacy_without_common_keys": true
    },
    "_rosy-fleet._tcp": {
      "role_column": "Fleet",
      "required": {"product": "rosy", "role": "fleet", "proto": "site-v1", "tls": "required"},
      "optional": ["tls_host"],
      "legacy_without_common_keys": false
    },
    "_rosy-overhead._tcp": {
      "role_column": "Rosy Vision",
      "required": {"product": "rosy", "role": "overhead-camera", "proto": "rosy-overhead/1", "tls": "required"},
      "required_tls_host": true,
      "optional": ["pair"],
      "legacy_without_common_keys": false
    }
  },
  "cases": [
    {"id": "robot_ok", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "192.168.1.10", "port": 8080,
     "txt": ["product=rosy", "role=robot", "proto=core-v1", "tls=none", "stage=CORE_READY", "release=018", "name=rosy-a", "network=sta"],
     "expect": {"accepted": true, "legacy": false}},
    {"id": "robot_unknown_key_ignored", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "192.168.1.10", "port": 8080,
     "txt": ["product=rosy", "role=robot", "proto=core-v1", "tls=none", "name=rosy-a", "network=sta", "colour=blue"],
     "expect": {"accepted": true, "legacy": false}},
    {"id": "robot_legacy_without_common_keys", "service_type": "_rosy._tcp", "host": "rosy-old.local", "address": "192.168.1.11", "port": 8080,
     "txt": ["stage=CORE_READY", "release=014", "name=rosy-old", "network=sta"],
     "expect": {"accepted": true, "legacy": true}},
    {"id": "robot_value_mismatch_proto", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "192.168.1.10", "port": 8080,
     "txt": ["product=rosy", "role=robot", "proto=core-v2", "tls=none", "name=rosy-a", "network=sta"],
     "expect": {"accepted": false, "reason": "value_mismatch"}},
    {"id": "robot_value_mismatch_role", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "192.168.1.10", "port": 8080,
     "txt": ["product=rosy", "role=fleet", "proto=core-v1", "tls=none", "name=rosy-a", "network=sta"],
     "expect": {"accepted": false, "reason": "value_mismatch"}},
    {"id": "robot_missing_key", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "192.168.1.10", "port": 8080,
     "txt": ["product=rosy", "role=robot", "proto=core-v1", "name=rosy-a", "network=sta"],
     "expect": {"accepted": false, "reason": "missing_key"}},
    {"id": "robot_duplicate_key", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "192.168.1.10", "port": 8080,
     "txt": ["product=rosy", "role=robot", "role=robot", "proto=core-v1", "tls=none", "name=rosy-a", "network=sta"],
     "expect": {"accepted": false, "reason": "duplicate_key"}},
    {"id": "robot_ap_mode", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "10.42.0.1", "port": 8080,
     "txt": ["product=rosy", "role=robot", "proto=core-v1", "tls=none", "name=rosy-a", "network=ap"],
     "expect": {"accepted": false, "reason": "ap_mode"}},
    {"id": "robot_legacy_ap_mode", "service_type": "_rosy._tcp", "host": "ap.local", "address": "10.42.0.1", "port": 8080,
     "txt": ["name=rosy-a", "network=ap"],
     "expect": {"accepted": false, "reason": "ap_mode"}},
    {"id": "robot_bad_address_link_local", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "169.254.2.3", "port": 8080,
     "txt": ["product=rosy", "role=robot", "proto=core-v1", "tls=none", "name=rosy-a", "network=sta"],
     "expect": {"accepted": false, "reason": "bad_address"}},
    {"id": "robot_bad_address_public", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "8.8.8.8", "port": 8080,
     "txt": ["product=rosy", "role=robot", "proto=core-v1", "tls=none", "name=rosy-a", "network=sta"],
     "expect": {"accepted": false, "reason": "bad_address"}},
    {"id": "robot_bad_address_loopback", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "127.0.0.1", "port": 8080,
     "txt": ["product=rosy", "role=robot", "proto=core-v1", "tls=none", "name=rosy-a", "network=sta"],
     "expect": {"accepted": false, "reason": "bad_address"}},
    {"id": "robot_bad_address_ipv6", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "fd00::10", "port": 8080,
     "txt": ["product=rosy", "role=robot", "proto=core-v1", "tls=none", "name=rosy-a", "network=sta"],
     "expect": {"accepted": false, "reason": "bad_address"}},
    {"id": "robot_bad_port", "service_type": "_rosy._tcp", "host": "rosy-a.local", "address": "192.168.1.10", "port": 0,
     "txt": ["product=rosy", "role=robot", "proto=core-v1", "tls=none", "name=rosy-a", "network=sta"],
     "expect": {"accepted": false, "reason": "bad_port"}},
    {"id": "robot_bad_host", "service_type": "_rosy._tcp", "host": "evil.example", "address": "192.168.1.10", "port": 8080,
     "txt": ["product=rosy", "role=robot", "proto=core-v1", "tls=none", "name=rosy-a", "network=sta"],
     "expect": {"accepted": false, "reason": "bad_host"}},
    {"id": "fleet_ok", "service_type": "_rosy-fleet._tcp", "host": "fleet-a.local", "address": "192.168.1.20", "port": 8443,
     "txt": ["product=rosy", "role=fleet", "proto=site-v1", "tls=required"],
     "expect": {"accepted": true, "legacy": false}},
    {"id": "fleet_missing_common_keys_is_not_legacy", "service_type": "_rosy-fleet._tcp", "host": "fleet-a.local", "address": "192.168.1.20", "port": 8443,
     "txt": ["role=fleet", "tls=required"],
     "expect": {"accepted": false, "reason": "missing_key"}},
    {"id": "fleet_duplicate_key", "service_type": "_rosy-fleet._tcp", "host": "fleet-a.local", "address": "192.168.1.20", "port": 8443,
     "txt": ["product=rosy", "role=fleet", "role=fleet", "proto=site-v1", "tls=required"],
     "expect": {"accepted": false, "reason": "duplicate_key"}},
    {"id": "fleet_value_mismatch_tls", "service_type": "_rosy-fleet._tcp", "host": "fleet-a.local", "address": "192.168.1.20", "port": 8443,
     "txt": ["product=rosy", "role=fleet", "proto=site-v1", "tls=none"],
     "expect": {"accepted": false, "reason": "value_mismatch"}},
    {"id": "fleet_bad_host", "service_type": "_rosy-fleet._tcp", "host": "evil.example", "address": "192.168.1.20", "port": 8443,
     "txt": ["product=rosy", "role=fleet", "proto=site-v1", "tls=required"],
     "expect": {"accepted": false, "reason": "bad_host"}},
    {"id": "fleet_bad_address_link_local", "service_type": "_rosy-fleet._tcp", "host": "fleet-a.local", "address": "169.254.2.3", "port": 8443,
     "txt": ["product=rosy", "role=fleet", "proto=site-v1", "tls=required"],
     "expect": {"accepted": false, "reason": "bad_address"}},
    {"id": "wrong_type_http", "service_type": "_http._tcp", "host": "fleet-a.local", "address": "192.168.1.20", "port": 8443,
     "txt": ["product=rosy", "role=fleet", "proto=site-v1", "tls=required"],
     "expect": {"accepted": false, "reason": "wrong_type"}},
    {"id": "overhead_ok", "service_type": "_rosy-overhead._tcp", "host": "camera-site.local", "address": "192.168.1.30", "port": 8443,
     "txt": ["product=rosy", "role=overhead-camera", "proto=rosy-overhead/1", "tls=required", "tls_host=camera-site.local"],
     "expect": {"accepted": true, "legacy": false}},
    {"id": "overhead_tls_host_mismatch", "service_type": "_rosy-overhead._tcp", "host": "site-a.local", "address": "192.168.1.30", "port": 8443,
     "txt": ["product=rosy", "role=overhead-camera", "proto=rosy-overhead/1", "tls=required", "tls_host=site-b.local"],
     "expect": {"accepted": false, "reason": "tls_host_mismatch"}},
    {"id": "overhead_missing_tls_host", "service_type": "_rosy-overhead._tcp", "host": "camera-site.local", "address": "192.168.1.30", "port": 8443,
     "txt": ["product=rosy", "role=overhead-camera", "proto=rosy-overhead/1", "tls=required"],
     "expect": {"accepted": false, "reason": "missing_key"}},
    {"id": "overhead_value_mismatch_cleartext", "service_type": "_rosy-overhead._tcp", "host": "camera-site.local", "address": "192.168.1.30", "port": 8095,
     "txt": ["product=rosy", "role=overhead-camera", "proto=rosy-overhead/1", "tls=optional", "tls_host=camera-site.local"],
     "expect": {"accepted": false, "reason": "value_mismatch"}},
    {"id": "overhead_bad_tls_host", "service_type": "_rosy-overhead._tcp", "host": null, "address": "192.168.1.30", "port": 8443,
     "txt": ["product=rosy", "role=overhead-camera", "proto=rosy-overhead/1", "tls=required", "tls_host=camera.example"],
     "expect": {"accepted": false, "reason": "bad_host"}},
    {"id": "overhead_duplicate_key", "service_type": "_rosy-overhead._tcp", "host": "camera-site.local", "address": "192.168.1.30", "port": 8443,
     "txt": ["product=rosy", "role=overhead-camera", "proto=rosy-overhead/1", "tls=required", "tls=required", "tls_host=camera-site.local"],
     "expect": {"accepted": false, "reason": "duplicate_key"}},
    {"id": "overhead_multilabel_tls_host", "service_type": "_rosy-overhead._tcp", "host": null, "address": "192.168.1.30", "port": 8443,
     "txt": ["product=rosy", "role=overhead-camera", "proto=rosy-overhead/1", "tls=required", "tls_host=camera.site.local"],
     "expect": {"accepted": false, "reason": "bad_host"}},
    {"id": "overhead_tls_host_case", "service_type": "_rosy-overhead._tcp", "host": "Camera-Site.local.", "address": "192.168.1.30", "port": 8443,
     "txt": ["product=rosy", "role=overhead-camera", "proto=rosy-overhead/1", "tls=required", "tls_host=camera-site.LOCAL"],
     "expect": {"accepted": true, "legacy": false}}
  ]
}
