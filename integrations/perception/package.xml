<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception_runtime</name>
  <version>0.1.0</version>
  <description>ROS-free lane perception and learned-model runtime shared by the robot (control) and learning tools.</description>
  <maintainer email="56295815+livsbittt@users.noreply.github.com">livsbittt</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend version_gte="0.0.1">core_common</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
