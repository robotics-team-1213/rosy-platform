# Rosy OS .gitignore policy
#
# - Ignore what a tool regenerates (build output, caches, per-machine agent
#   state) and what must never be published (local overrides with robot URLs,
#   tokens, private keys). Everything else is reviewed and committed.
# - Evidence logs under docs/validation/**/evidence are intentional records and
#   stay tracked; do not add a blanket *.log rule.
# - deploy/robot/native/rosy-runtime.env is a non-secret template and stays
#   tracked. Real device copies live on the robot under /etc/rosy.
# - gitignore has no end-of-line comments: a trailing "# ..." becomes part of
#   the pattern, so every comment sits on its own line.
# - Package-local .gitignore files (e.g. src/core/control) only add rules for
#   that package; shared rules belong here.

# colcon / ROS workspace output, at any depth
build/
install/
log/
.colcon/

# Python bytecode, packaging and virtualenvs
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/

# Test, lint and type-check caches
.pytest_cache/
.pytest-tmp*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Frontend build output
node_modules/
dist/

# THIS REPO IS PUBLIC. Internal material (drafts, strategy, vendor documents,
# site notes, real device addresses) goes in /private/, which never leaves this
# machine. What moves from there into docs/ is decided by ADR.
/private/

# Local overrides that carry robot URLs or tokens (games robots.py overlay)
match.local.yaml
*.local.env
.env
.env.*
!.env.example

# Private key material. Public release keys under deploy/release/public-keys
# are .pem and stay tracked; private keys are never committed.
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*

# Per-device provisioning: Wi-Fi PSK, AP password, core API credential.
# The schema and rosy-config.template.yaml stay tracked; filled copies do not.
provision.json
rosy-config.yaml

# Diagnostic bundles pulled from a robot (rosy_diag_collect.py)
rosy-diag-*.tar.gz

# SD/OS images and ROS bag recordings
*.img
*.img.xz
*.img.gz
*.iso
*.mcap
*.db3
rosbag2_*/

# Fleet local databases
*.sqlite3
*.db

# Session recordings stay untracked. Learning clips under teleop/learning are tracked.
data/teleop/*
data/drive/**
!data/teleop/.gitkeep
!data/teleop/learning/
!data/drive/.gitkeep

# One-off helper scripts at the repository root. Durable root helpers
# (env.sh) is tracked explicitly; new throwaway
# scripts belong in tools/ or outside the repo.
/*.py

# Upstream reference archives (never vendored)
reference/src/*.zip

# Agent and tool state, per-machine (.omc/skills is committable)
.omc/
!.omc/skills/
.omo/
.codegraph/
.claude/settings.local.json
.claude/worktrees/

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Linked checkouts. Not part of this branch.
.worktrees/
