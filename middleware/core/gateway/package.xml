<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>core</name>
  <version>0.1.0</version>
  <description>ROSY CORE robot middleware — identity, capability, state, command arbitration, safety, navigation, waypoints, events, REST/WS API (ROSY-CORE-SRS-001)</description>
  <maintainer email="dev@rosy.local">rosy</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <!-- SLAM(NAV-005) 에만 필요한 선택적 런타임 의존성. core 이미지에는 없고
       pi5-lite capabilities 는 slam: false 다. ros_bridge 는 이를 생성자에서
       try/except 로 임포트하므로 최상단 import 로 되돌리지 말 것. -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <depend>core_common</depend>
  <depend>core_events</depend>
  <depend>core_features</depend>
  <depend>core_api_web</depend>
</package>
