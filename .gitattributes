.gitattributes text eol=lf
*.sh text eol=lf
integrations/simulation/gazebo/scripts/*.py text eol=lf

# map_v2_fleet generated outputs must be byte-deterministic across checkouts
# (test_map_v2_fleet_scene.py compares them byte for byte). core.autocrlf=true
# would otherwise normalise the text .world/.yaml to CRLF on Windows checkout,
# and could mangle the binary .stl/.pgm if git's binary heuristic misfires.
# Paths follow the bundle: src/apps/control -> middleware/perception (D-241).
middleware/perception/map/map_v2_fleet/worlds/*.world text eol=lf
middleware/perception/map/map_v2_fleet/meshes/*.stl binary
middleware/perception/map/map_v2_fleet/maps/*.pgm binary
middleware/perception/map/map_v2_fleet/maps/*.yaml text eol=lf
"middleware/perception/map/map_v2_fleet/260919 MAP FILE.STL" binary
middleware/perception/map/map_v2_fleet/lane_graph.yaml text eol=lf
deploy/robot/native/rosy-diag text eol=lf
# D-189: inputs.lock.yaml pins this file by SHA-256; its bytes must not change per checkout.
deploy/robot/pinky_pro/image/device-python-requirements.txt text eol=lf
deploy/robot/pinky_pro/image/camera-sources.lock.json text eol=lf
deploy/robot/pinky_pro/image/camera-python-requirements.txt text eol=lf
# D-373: systemd EnvironmentFile would read a CRLF value as "false" (not a switch value).
deploy/robot/pinky_pro/native/learned-perception.env.example text eol=lf
# D-247: inputs.lock.yaml pins the rpi_ws281x patch by SHA-256; the overlay and
# the udev/modprobe files go into the image byte for byte.
deploy/robot/pinky_pro/image/patches/*.patch text eol=lf
deploy/robot/omx/patches/*.patch text eol=lf whitespace=-blank-at-eol
deploy/robot/pinky_pro/image/overlays/*.dts text eol=lf
deploy/robot/udev/*.rules text eol=lf
deploy/robot/modprobe/*.conf text eol=lf
docs/validation/pinky-vendor-boot-2026-09-24/config.txt -text
docs/validation/pinky-vendor-boot-2026-09-24/cmdline.txt -text
docs/validation/model-tool-artifact-2026-10-01/manifest.json text eol=lf
docs/validation/model-tool-artifact-2026-10-01/manifest.sha256 text eol=lf
deploy/site/rosy-model-watch text eol=lf

# Vendored OMX assets are pinned by sha256 in manifest.json; never convert line endings.
learning/envs/isaac/assets/** -text

# D-508: append-only records take both sides on merge (git built-in union driver).
# Union can duplicate or reorder lines; the harness lint dedupes gaps and ignores row order.
"docs/reference/ROSY ADR Log.md" merge=union
**/logs.md merge=union
tools/harness/adr_gaps.txt merge=union
