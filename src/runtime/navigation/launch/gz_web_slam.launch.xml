<?xml version='1.0'?>
<launch>
    <!-- D-3: Rosy OS FastAPI (:8080) owns the web surface. -->
    <arg name="use_sim_time" default="True"/>
    <arg name="params_file" default="$(find-pkg-share navigation)/params/nav2_params.yaml"/>
    <arg name="slam_params_file" default="$(find-pkg-share navigation)/params/mapper_params.yaml"/>

    <node pkg="core" exec="core" name="core" output="screen"/>

    <include file="$(find-pkg-share navigation)/launch/navigation_launch.xml">
        <arg name="params_file" value="$(var params_file)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

    <include file="$(find-pkg-share navigation)/launch/map_building.launch.xml">
        <arg name="slam_params_file" value="$(var slam_params_file)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

</launch>
