<?xml version='1.0' ?>

<launch>
    <arg name="namespace" default=""/>
    <arg name="robot_name" default="$(var namespace)rosy"/>
    <arg name="cam_tilt_deg" default="0"/>
    <arg name="world_name" default="rosy_factory.world"/>
    <arg name="world" default="$(find-pkg-share gz_sim)/worlds/$(var world_name)"/>
    <arg name="bridge_params" default="$(find-pkg-share gz_sim)/params/rosy_bridge.yaml"/>
    <arg name="bridge_image" default="false"/>
    <arg name="gui" default="true"/>
    <arg name="camera_width" default="1280"/>
    <arg name="camera_height" default="720"/>
    <arg name="camera_update_rate" default="10"/>
    <arg name="spawn_x" default="0.0"/>
    <arg name="spawn_y" default="0.0"/>
    <arg name="spawn_z" default="0.1"/>
    <arg name="spawn_yaw" default="0.0"/>
    <!-- Raw text appended to the default GZ_SIM_RESOURCE_PATH below, e.g. a
         world referencing another package's model://<pkg>/... asset needs
         that package's share dir added here (with its own leading ":") --
         because $(find-pkg-share description)/.. only resolves to a shared
         install/share under --merge-install; colcon's default isolated
         (--symlink-install) layout gives install/description/share, which
         has no sibling package dirs (e.g. control/) on it. Left empty (the
         default), GZ_SIM_RESOURCE_PATH is byte-identical to before this arg
         existed. -->
    <arg name="extra_resource_path" default=""/>

    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share description)/../:/$(find-pkg-share gz_sim)/models:/$(env HOME)/.gazebo/models$(var extra_resource_path)"/>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name='gz_args' value='-r -s -v4, $(var world)'/>
        <arg name='on_exit_shutdown' value='true'/>
    </include>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" if="$(var gui)">
        <arg name='gz_args' value='-g -v4 '/>
    </include>

    <include file="$(find-pkg-share description)/launch/upload_robot.launch.py">
        <arg name='namespace' value='$(var namespace)'/>
        <arg name='use_sim_time' value='True'/>
        <arg name='is_sim' value='True'/>
        <arg name='cam_tilt_deg' value='$(var cam_tilt_deg)'/>
        <arg name='camera_width' value='$(var camera_width)'/>
        <arg name='camera_height' value='$(var camera_height)'/>
        <arg name='camera_update_rate' value='$(var camera_update_rate)'/>
    </include>

    <node pkg="ros_gz_sim" exec="create" name='create' output='screen' args="-name $(var robot_name) -topic $(var namespace)/robot_description -x $(var spawn_x) -y $(var spawn_y) -z $(var spawn_z) -Y $(var spawn_yaw)">
        <param name='use_sim_time' value='True'/>
    </node>

    <node pkg="ros_gz_bridge" exec="parameter_bridge" name='parameter_bridge' output='screen' args="--ros-args -p config_file:=$(var bridge_params)"/>
    <node pkg="ros_gz_image" exec="image_bridge" name='image_bridge' output='screen'
          args="/camera/image_raw" if="$(var bridge_image)">
        <remap from="/camera/image_raw" to="camera/front"/>
    </node>
</launch>
