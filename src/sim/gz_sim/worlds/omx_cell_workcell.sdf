<?xml version="1.0"?>
<!--
  Rosy Cell C3 OMX-F workcell (SIMULATION ONLY, D-402 / D-403 §5).

  Frame transform: Gazebo world == OMX robot_base (link0). The vendor launch
  omx_f_follower_ai_gazebo.launch.py spawns omx_f at x=y=z=0, R=P=Y=0 and the URDF
  joint world_fixed is the identity, so every pose below is already in the base frame
  used by operations/processes/cell/examples/omx_sim/cell.yaml. Table top = z 0.

  Layout (must match cell.yaml / recipe.yaml; test/test_cell_omx_sim_layout_contract.py):
    pallet_a  0.10 x 0.08 x 0.01 plate, near-left top corner (0.13,  0.01, 0.01)
    pallet_b  0.10 x 0.08 x 0.01 plate, near-left top corner (0.13, -0.09, 0.01)
    infeed    block 0.04 x 0.03 x 0.03 (20 g foam), top face centre (0.00, 0.17, 0.03), yaw pi/2
              (length along y, C3b: a yaw-0 pick needs joint5 ~ pi/2, where the fingers stop
              on the wrist at ~0.47 rad in Gazebo even with nothing between them)
    sheets    stand 0.028 m + one 0.002 m sheet, top face centre (0.00, -0.17, 0.03)
  No physical calibration; the block is the only free object used by C3.

  No camera: with the headless software-rendered (LIBGL_ALWAYS_SOFTWARE) 320x240 workcell
  camera the real-time factor measured 0.06 on the C3 host; without it 0.3-0.7 (2026-10-02).
  Physics step 2 ms (pilot world: 1 ms) to raise RTF: the owner's action timeout is wall time.
-->

<sdf version="1.9">
  <world name="omx_cell_workcell">
    <physics name="physics" type="ignored">
      <max_step_size>0.002</max_step_size><real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.3 0.2 -1</direction>
    </light>

    <model name="table">
      <static>true</static>
      <pose>0.05 0 -0.01 0 0 0</pose>
      <link name="top">
        <collision name="collision">
          <geometry><box><size>0.7 0.7 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 0.02</size></box></geometry>
          <material><diffuse>0.55 0.5 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_a">
      <static>true</static>
      <pose>0.18 0.05 0.005 0 0 0</pose>
      <link name="plate">
        <collision name="collision">
          <geometry><box><size>0.10 0.08 0.01</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.08 0.01</size></box></geometry>
          <material><diffuse>0.2 0.45 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_b">
      <static>true</static>
      <pose>0.18 -0.05 0.005 0 0 0</pose>
      <link name="plate">
        <collision name="collision">
          <geometry><box><size>0.10 0.08 0.01</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.08 0.01</size></box></geometry>
          <material><diffuse>0.2 0.7 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="sheet_stand">
      <static>true</static>
      <pose>0 -0.17 0.014 0 0 0</pose>
      <link name="stand">
        <collision name="collision">
          <geometry><box><size>0.09 0.07 0.028</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.09 0.07 0.028</size></box></geometry>
          <material><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="slip_sheet_0">
      <pose>0 -0.17 0.029 0 0 0</pose>
      <link name="sheet">
        <inertial>
          <mass>0.005</mass>
          <inertia><ixx>2.0e-6</ixx><iyy>3.4e-6</iyy><izz>5.4e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.09 0.07 0.002</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.09 0.07 0.002</size></box></geometry>
          <material><diffuse>0.85 0.8 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Infeed block: 40 x 30 x 30 mm, 20 g. Inertia = m/12 * (b^2 + c^2). -->
    <model name="infeed_block">
      <pose>0 0.17 0.015 0 0 1.5707963267948966</pose>
      <link name="block">
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>3.0e-6</ixx><iyy>4.17e-6</iyy><izz>4.17e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.03 0.03</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.03 0.03</size></box></geometry>
          <material><diffuse>0.9 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
