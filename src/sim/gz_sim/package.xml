<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_sim</name>
  <version>0.0.0</version>
  <description>Gazebo simulation worlds, multi-robot launch files and lamp plugin.</description>
  <maintainer email="byeongkyu@gmail.com">byeongkyu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ros_gz</depend>
  <depend>gz_ros2_control</depend>

  <!-- scripts/swarm_bench.py 가 fleet 를 import 한다. 런타임 의존이지 빌드 의존이 아니다. -->
  <exec_depend>fleet</exec_depend>
  <!-- launch/gz_multi.launch.py 가 navigation.frame_prefix 를 import 한다 (D-126 S4).
       시뮬 런치가 내비 헬퍼를 쓰는 것은 하향 의존이라 허용, 선언으로 고정한다. -->
  <exec_depend>navigation</exec_depend>
  <!-- Exact simulation benches may be installed assets owned by Control. -->
  <exec_depend>description</exec_depend>
  <exec_depend>control</exec_depend>
  <exec_depend>core</exec_depend>
  <exec_depend>navigation</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
