<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="insert_gz_sim" params="namespace camera_width camera_height camera_update_rate camera_hfov:=1.1519">
        <gazebo>
            <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
                <left_joint>${namespace}l_wheel_joint</left_joint>
                <right_joint>${namespace}r_wheel_joint</right_joint>
                <wheel_separation>0.0961</wheel_separation>
                <wheel_radius>0.028</wheel_radius>

                <min_velocity>-1.0</min_velocity>
                <max_velocity>1.0</max_velocity>

                <min_acceleration>-2.0</min_acceleration>
                <max_acceleration>2.0</max_acceleration>  
                <topic>${namespace}cmd_vel</topic>
                
                <!-- Wheel-integrated odometry remains available for slip
                     diagnostics, but does not drive SLAM in simulation. -->
                <odom_topic>${namespace}odom_wheel</odom_topic>
                <frame_id>${namespace}odom</frame_id>
                <child_frame_id>${namespace}base_footprint</child_frame_id>
                <odom_publisher_frequency>30</odom_publisher_frequency>

                <tf_topic>${namespace}tf_wheel</tf_topic>
            </plugin>

            <!-- Gazebo model-pose odometry is the simulation equivalent of a
                 calibrated localization source.  It prevents DART wheel scrub
                 from corrupting the SLAM pose while retaining wheel odometry
                 above for direct comparison. -->
            <plugin filename="gz-sim-odometry-publisher-system"
                    name="gz::sim::systems::OdometryPublisher">
                <odom_frame>${namespace}odom</odom_frame>
                <robot_base_frame>${namespace}base_footprint</robot_base_frame>
                <odom_publish_frequency>30</odom_publish_frequency>
                <dimensions>2</dimensions>
                <odom_topic>${namespace}odom</odom_topic>
                <tf_topic>/tf</tf_topic>
            </plugin>

            <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
                <topic>${namespace}joint_states</topic>
                <joint_name>${namespace}l_wheel_joint</joint_name>
                <joint_name>${namespace}r_wheel_joint</joint_name>
            </plugin>
            
            <plugin filename="gz-sim-lamp-control-system" name="gz_sim::LampControlPlugin">
                <link>robot_lamp</link>
            </plugin>
        </gazebo>

        <gazebo reference="l_wheel">
            <self_collide>0</self_collide>
            <!-- Longitudinal grip with low lateral scrub resistance lets the
                 differential drive pivot without dragging the chassis. -->
            <fdir1>1 0 0</fdir1>
            <mu1>1.0</mu1>
            <mu2>0.05</mu2>
            <kp>10000000.0</kp>
            <kd>1.0</kd>
            <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="r_wheel">
            <self_collide>0</self_collide>
            <fdir1>1 0 0</fdir1>
            <mu1>1.0</mu1>
            <mu2>0.05</mu2>
            <kp>10000000.0</kp>
            <kd>1.0</kd>
            <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="caster_wheel">
            <self_collide>0</self_collide>
            <mu1>0.1</mu1>
            <mu2>0.1</mu2>
            <kp>10000000.0</kp>
            <kd>1.0</kd>
            <!-- <minDepth>0.001</minDepth> -->
        </gazebo>

        <gazebo reference="${namespace}robot_lamp_mount_fixed_joint">
            <disableFixedJointLumping>true</disableFixedJointLumping>
        </gazebo>

        <gazebo reference="rplidar_link">
            <sensor name='gpu_lidar' type='gpu_lidar'>
                <topic>${namespace}scan</topic>
                <update_rate>10</update_rate>
                <gz_frame_id>${namespace}rplidar_link</gz_frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>640</samples>
                            <!-- <resolution>1</resolution> -->
                            <min_angle>${-pi}</min_angle>
                            <max_angle>${pi}</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>0.01</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.05</min>
                        <max>12.0</max>
                        <resolution>0.03</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.02</stddev>
                    </noise>
                </lidar>
                <visualize>false</visualize>
            </sensor>
        </gazebo>

        <gazebo reference="front_camera_link">
            <sensor name="camera" type="camera">
                <camera>
                    <horizontal_fov>${camera_hfov}</horizontal_fov>
                    <image>
                        <width>${camera_width}</width>
                        <height>${camera_height}</height>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>100</far>
                    </clip>
                </camera>
                <!-- 구독자가 있을 때만 그린다 (D-34). always_on 1 은 아무도 보지 않는
                     1280x720 프레임을 초당 30 장 렌더한다. GPU 없는 WSL 의
                     소프트웨어 렌더러에서 그 하나가 RTF 를 0.07 로 끌어내렸고,
                     0 으로 바꾼 뒤 같은 기계에서 0.98 이 나왔다. 라이다와 항법이
                     함께 굶던 원인이다.
                     이 파일의 주석에는 콜론과 따옴표를 쓰지 않는다. launch 가
                     robot_description 을 YAML 로 한 번 훑기 때문에 그 둘이 있으면
                     문자열이 매핑으로 읽혀 런치가 통째로 깨진다. -->
                <always_on>0</always_on>
                <update_rate>${camera_update_rate}</update_rate>
                <visualize>false</visualize>
                <topic>${namespace}camera/image_raw</topic>
                <gz_frame_id>${namespace}front_camera_link</gz_frame_id>
            </sensor>
        </gazebo>

        <gazebo reference="imu_link">
            <sensor name="imu" type="imu">
                <always_on>1</always_on>
                <update_rate>100</update_rate>
                <visualize>true</visualize>
                <topic>${namespace}imu_raw</topic>
                <enable_metrics>true</enable_metrics>
                <gz_frame_id>${namespace}imu_link</gz_frame_id>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>
