<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>overhead</name>
  <version>0.1.0</version>
  <description>Receive-only rosy-overhead/1 ingest adapter. No ROS, no cmd_vel, no marker detection.</description>
  <maintainer email="kyung133851@pinklab.art">ROSY</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3-websockets</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
