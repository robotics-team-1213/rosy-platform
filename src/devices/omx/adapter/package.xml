<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omx_adapter</name>
  <version>0.1.0</version>
  <description>ROS-native OMX adapter profile and ros2_control contract boundary.</description>
  <maintainer email="kyung133851@pinklab.art">ROSY</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- Runtime ROS dependencies are added when a measured OMX driver is selected.
       The disabled profile must remain installable without vendor hardware. -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
