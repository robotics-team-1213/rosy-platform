#!/usr/bin/env bash
# D-346 pre-push fast gate: the tier that catches what landed red on
# 2026-09-29 (ADR body gaps, io closure, version pins, size verdicts).
# 2026-10-01: + dashboard contract suites (gateway) and root contract suites.
#   The D-362 P1 dashboard split landed red (runs 36741368088, 36742855223)
#   and the secret-scan/scorecard/robot-literal classes followed (36743819104)
#   because this tier never read those files. Measured cost: ~3 min on Windows.
# 2026-10-03 (D-436): + affected tier after the fast suites.
# 2026-10-08: pytest runs on a lab PC (tools/remote/remote_pytest.py; host by headroom, D-568),
#   on the commit being pushed; an unavailable test host stops the push.
# Install: tools/hooks/install.sh   Uninstall: rm .git/hooks/pre-push
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Git passes `<remote> <url>` and `<local ref> <local sha> <remote ref> <remote sha>`
# lines on stdin. The gate tests that one pushed commit (deletions skipped); a push of
# several different commits is refused. Without the two arguments (a manual
# `git show ...:pre-push | bash`) stdin is the script, and HEAD is tested.
PUSH_SHA=""
PUBLISH_REF=""
# D-868: a clone with `git config rosy.publishOnly true` (the shared agent clone) reaches
# origin only through publish/main-* PRs; teammates' clones leave it unset and are not gated.
PUBLISH_ONLY=$(git config --bool rosy.publishOnly 2>/dev/null || true)
if [ $# -ge 2 ]; then
  while read -r _ local_sha remote_ref _; do
    if [ "$PUBLISH_ONLY" = "true" ] && [ -z "${ROSY_PUSH_REASON:-}" ]; then
      case "$local_sha:$remote_ref" in
        *[!0]*:refs/heads/publish/main-*) ;;
        *[!0]*:*)
          echo "[pre-push] rosy.publishOnly: $remote_ref is not publish/main-*. Land on local main and publish (D-868)." >&2
          echo "[pre-push] incident only: ROSY_PUSH_REASON=\"<why>\" git push ..." >&2
          exit 1 ;;
      esac
    fi
    case "$local_sha:$remote_ref" in *[!0]*:refs/heads/publish/main-*) PUBLISH_REF=1 ;; esac
    case "$local_sha" in
      *[!0]*)
        # An annotated tag pushes a tag object; compare the commit it names.
        local_sha=$(git rev-parse --verify -q "$local_sha^{commit}" 2>/dev/null || echo "$local_sha")
        if [ -n "$PUSH_SHA" ] && [ "$PUSH_SHA" != "$local_sha" ]; then
          echo "[pre-push] this push carries several commits ($PUSH_SHA, $local_sha); the gate tests one. Push one ref at a time." >&2
          exit 1
        fi
        PUSH_SHA="$local_sha" ;;
    esac
  done
fi
PUSH_SHA="${PUSH_SHA:-$(git rev-parse HEAD)}"
# 2026-10-26: the shared clone ran a 2026-10-11 copy of this hook for two weeks; every later gate was
# skipped. An installed copy that differs from the pushed commit's hook refuses until reinstalled.
if [ "$PUBLISH_ONLY" = "true" ] && [ -f "$0" ] \
   && tracked=$(git show "$PUSH_SHA:tools/hooks/pre-push" 2>/dev/null) \
   && [ "$(printf '%s\n' "$tracked" | sed 's/\r$//')" != "$(sed 's/\r$//' "$0")" ]; then
  echo "[pre-push] $0 is not the pushed commit's tools/hooks/pre-push; run: bash tools/hooks/install.sh" >&2
  exit 1
fi
# Git exports repository-local variables to hooks. Clear them after locating
# this checkout: gate tests create foreign repositories, where inherited
# GIT_DIR/GIT_COMMON_DIR override git -C and can mutate this repository.
# https://git-scm.com/docs/githooks
while IFS= read -r git_local_variable; do
  unset "$git_local_variable"
done < <(git rev-parse --local-env-vars)

# 2026-10-26 (robot-4d, exit 4 twice): lint and the affected selector read files, and main had moved
# past the pinned PUSH_SHA, so tests absent from it were sent. When the checkout is not exactly
# PUSH_SHA (other HEAD, or tracked/staged edits) every later step runs in a detached copy of it.
if [ "$(git rev-parse HEAD)" != "$PUSH_SHA" ] || ! git diff --quiet HEAD --; then
  PUSH_TREE="$(git rev-parse --path-format=absolute --git-common-dir)/rosy-prepush/$$"
  CHECKOUT="$PWD"
  # Leave the copy before removing it: Windows cannot delete the current directory.
  trap 'cd "$CHECKOUT" && git worktree remove --force "$PUSH_TREE" >/dev/null 2>&1 || true' EXIT
  git worktree add --detach --quiet "$PUSH_TREE" "$PUSH_SHA"
  echo "[pre-push] checkout is not ${PUSH_SHA:0:10}; judging that commit in $PUSH_TREE"
  cd "$PUSH_TREE"
fi

PY=""
for candidate in python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 \
     && "$candidate" -c "import yaml" >/dev/null 2>&1; then
    PY="$candidate"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "[pre-push] no python interpreter with PyYAML found on PATH" >&2
  exit 1
fi

# 2026-10-05: ~5100 commits were authored with a repo-local identity whose email
# belongs to another person's GitHub account, so GitHub credited them to him.
case "$(git config user.email)" in
  *@pinklab.art)
    echo "[pre-push] git user.email $(git config user.email) is not yours; set your own GitHub email (docs/reference/team-guide.md §1.3)" >&2
    exit 1 ;;
esac

echo "[pre-push] harness lint (ADR duplicates, mojibake, append-only, staleness)"
"$PY" tools/harness/rosy_harness.py lint

# D-347 회차의 교훈(2026-09-29, CI 적신 2건): lint 는 작업 트리만 본다. 재생성된
# index.md/STATUS.md 를 커밋 없이 두면 lint 는 녹색이지만 push 는 낡은 커밋 사본을
# 출하한다. 생성 기록이 dirty 면 push 하지 않는다 — 커밋하거나 되돌려라.
echo "[pre-push] uncommitted generated records"
"$PY" - <<'EOF'
import pathlib
import subprocess
import sys

sys.path.insert(0, "tools/harness")
import rosy_harness as harness  # noqa: E402

repo = pathlib.Path(".").resolve()
targets = [p.relative_to(repo).as_posix() for p in harness.generated_targets(repo)]
out = subprocess.run(
    ["git", "status", "--porcelain", "--", *targets],
    capture_output=True, text=True,
).stdout.strip()
if out:
    sys.stderr.write(
        "generated records are regenerated but uncommitted:\n" + out
        + "\ncommit them (or restore) before pushing — pushing now ships the"
        " stale committed copies (the 2026-09-29 red-CI class).\n")
    sys.exit(1)
EOF

# D-430 §5, D-762 stage 0: the rule CI's scope job enforces, on the range a push to main
# makes it check (origin/main..tip), refused here rather than red on main after the push.
# No origin/main would narrow the check to the tip alone (the new-branch rule): refuse instead.
git rev-parse --verify -q origin/main >/dev/null || {
  echo "[pre-push] no origin/main ref: the Safety-Review range cannot be checked; git fetch origin first" >&2
  exit 1
}
# D-889 5: a publish push puts the whole range's history on a public repo. A plain git push to
# publish/main-* skipped publish_main.py's per-commit scan (2026-10-27), so the hook runs it too.
if [ -n "$PUBLISH_REF" ] && [ -f tools/publish_main.py ]; then
  echo "[pre-push] secret scan on origin/main..${PUSH_SHA:0:10}"
  "$PY" tools/publish_main.py --secret-scan "$PUSH_SHA" || exit 1
fi
echo "[pre-push] Safety-Review trailer on origin/main..${PUSH_SHA:0:10}"
if ! SAFETY_OUT="$("$PY" tools/harness/safety_review.py origin/main "$PUSH_SHA" 2>&1)"; then
  printf '%s\n' "$SAFETY_OUT" >&2
  case "$SAFETY_OUT" in
    *"without a \`Safety-Review:"*)
      echo "[pre-push] the commits listed are already in the pushed range and stay there if re-created;" \
           "the way out is their full SHA in tools/harness/safety_review_exempt.json with an independent" \
           "review (D-430 §5). Ask the author named above." >&2 ;;
  esac
  exit 1
fi
printf '%s\n' "$SAFETY_OUT"

# D-766 2: every pushed commit passes the size rule on its own (git only, no tests).
if [ -f tools/harness/size_range.py ]; then
  echo "[pre-push] size rule per commit on origin/main..${PUSH_SHA:0:10}"
  "$PY" tools/harness/size_range.py origin/main "$PUSH_SHA" || exit 1
fi

FAST_SUITES=(
  test/test_harness_contracts.py
  test/architecture/test_module_structure.py
  test/test_io_image_closure.py
  test/test_line_follow_contract_docs.py
  test/test_behavior_test_ownership.py
  test/test_module_scorecard.py
  test/test_release_boundary_guards.py
  test/test_robot_literals.py
  middleware/core/gateway/test/test_protocol_version_alignment.py
  middleware/core/gateway/test/test_event_catalogue.py
  middleware/core/gateway/test/test_console_layout.py
  middleware/core/gateway/test/test_host_cards.py
  middleware/core/gateway/test/test_host_hardware.py
  middleware/core/gateway/test/test_triage_contract.py
  middleware/core/gateway/test/test_host_status_summary.py
)
# D-436: affected tier on top of the fast suites (whose contents stay as they
# are). Tests of the modules this branch touches, their direct reverse
# dependents, the tests naming the changed paths and the guard set. When the
# selector escalates to FULL (shared foundation, CI/test config, unmapped file)
# only the guards and the suites mapped from the changed files (owning module,
# direct reverse dependents, referencing tests) run: the full suite runs on
# GitHub Actions runners (ci.yml), never here.
# D-553 addendum 3 (user decision 2026-10-10): when every commit past origin/main was
# landed by tools/land.py with its affected tier green (land records in
# <git-common-dir>/rosy-land), reuse those results and run only the fast suites no
# record ran. A missing record (hand-landed commit, --tests none) runs the gate below.
if OWED="$("$PY" tools/hooks/land_record.py owed --head "$PUSH_SHA" --upstream origin/main "${FAST_SUITES[@]}")"; then
  if [ -z "$OWED" ]; then
    echo "[pre-push] land records cover origin/main..${PUSH_SHA:0:10}; no suite owed"
  else
    echo "[pre-push] land records cover origin/main..${PUSH_SHA:0:10}; fast suites not in them:"
    mapfile -t OWED_SUITES < <(printf '%s\n' "$OWED" | tr -d '\r')
    "$PY" tools/remote/remote_pytest.py --sha "$PUSH_SHA" -- "${OWED_SUITES[@]}"
  fi
  echo "[pre-push] fast gate green (land records reused)"
  exit 0
fi
AFFECTED_BASE="$(git merge-base "$PUSH_SHA" origin/main 2>/dev/null || echo main)"
# --skip: the fast suites (most of the guard set) run first; do not run them twice.
AFFECTED_SKIP=()
for suite in "${FAST_SUITES[@]}"; do AFFECTED_SKIP+=(--skip "$suite"); done
echo "[pre-push] fast contract suites, then affected tier (D-436, base ${AFFECTED_BASE}), commit ${PUSH_SHA:0:10}"
# D-584: no reachable test host waits, then fails the push; there is no local run.
"$PY" tools/harness/rosy_harness.py affected --base "$AFFECTED_BASE" --head "$PUSH_SHA" --json \
  | "$PY" tools/remote/remote_pytest.py --sha "$PUSH_SHA" --affected-json - \
      "${AFFECTED_SKIP[@]}" -- "${FAST_SUITES[@]}"

echo "[pre-push] fast gate green"
